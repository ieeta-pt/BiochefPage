# Cloudflare Web Analytics (cookieless, privacy-friendly, no consent banner).
# Copy to `.env` for local builds. In CI this is injected from a GitHub
# repository variable (see .github/workflows/deploy.yml).
#
# Token from the Cloudflare dashboard: Analytics & Logs → Web Analytics →
# add site home.biochef.app → it gives you a beacon token (hex string).
# Public by design — it appears in the page HTML — but kept out of source via env.
# Absent → no analytics script ships at all.
PUBLIC_CF_BEACON_TOKEN=
