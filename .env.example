# Umami analytics (cookieless, privacy-friendly).
# Copy to `.env` for local builds. In CI these are injected from GitHub
# repository variables (see .github/workflows/deploy.yml).
#
# The website id Umami assigns to home.biochef.app (Settings → Websites → Edit).
# Public by design — it appears in the page HTML — but kept out of source via env.
PUBLIC_UMAMI_WEBSITE_ID=

# Script host. Defaults to Umami Cloud when unset; override for self-hosting.
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
