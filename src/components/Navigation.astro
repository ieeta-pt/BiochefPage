---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Why BioChef', href: '/why' },
  { label: 'Architecture', href: '/architecture' },
  { label: 'Workflows', href: '/workflows' },
  { label: 'Developers', href: '/developers' },
  { label: 'Community', href: '/community' }
];

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const brandLogo = withBase('/img/biochef-logo.png');
const currentPath = Astro.url?.pathname || '';

const isActive = (href: string) => {
  const target = withBase(href);
  return currentPath === target || currentPath === `${target}/`;
};
---

<header
  class="fixed top-0 left-0 right-0 z-50"
  id="main-nav"
>
  <div class="container-main">
    <nav class="flex items-center justify-between h-16 md:h-20">
      <!-- Brand -->
      <a
        class="nav-brand focus:outline-none focus-visible:ring-2 focus-visible:ring-brand/40 rounded-lg"
        href={withBase('/')}
        aria-label="BioChef home"
      >
        <div class="nav-logo-mark" style={`--logo-url: url(${brandLogo})`} aria-hidden="true"></div>
        <span class="tracking-tight">BioChef</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-6 xl:gap-8">
        {navItems.map((item) => (
          <a
            class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
            href={withBase(item.href)}
          >
            {item.label}
          </a>
        ))}
        <a
          class="nav-github-pill"
          href="https://github.com/ieeta-pt/Biochef"
          target="_blank"
          rel="noreferrer"
          aria-label="View BioChef on GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.426 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.009-.868-.014-1.703-2.782.605-3.37-1.343-3.37-1.343-.454-1.154-1.11-1.461-1.11-1.461-.908-.62.069-.608.069-.608 1.003.07 1.531 1.031 1.531 1.031.892 1.53 2.341 1.088 2.91.833.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.748-1.027 2.748-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.847-2.338 4.695-4.566 4.943.359.31.678.92.678 1.855 0 1.338-.012 2.419-.012 2.748 0 .268.18.58.688.482A10.025 10.025 0 0 0 22 12.017C22 6.484 17.523 2 12 2Z" clip-rule="evenodd" />
          </svg>
          <span class="hidden xl:inline">GitHub</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        class="lg:hidden flex items-center justify-center w-11 h-11 rounded-lg text-text hover:bg-background transition-colors"
        id="mobile-menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu-overlay" id="mobile-menu-overlay" aria-hidden="true"></div>

<!-- Mobile Menu Drawer -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Navigation menu">
  <div class="flex flex-col h-full">
    <!-- Header -->
    <div class="flex items-center justify-between p-4 border-b border-border">
      <span class="font-bold text-lg text-text">Menu</span>
      <button
        class="flex items-center justify-center w-11 h-11 rounded-xl hover:bg-background transition-colors"
        id="mobile-menu-close"
        aria-label="Close menu"
      >
        <svg class="w-6 h-6 text-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation Links -->
    <nav class="flex-1 overflow-y-auto p-4">
      <ul class="space-y-1">
        {navItems.map((item) => (
          <li>
            <a
              class={`flex items-center px-4 py-3 rounded-md text-base font-medium transition-colors border-l-2 ${
                isActive(item.href)
                  ? 'border-brand text-brand bg-transparent'
                  : 'border-transparent text-text hover:bg-background'
              }`}
              href={withBase(item.href)}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Footer -->
    <div class="p-4 border-t border-border safe-bottom">
      <a
        class="btn btn-primary w-full"
        href="https://github.com/ieeta-pt/Biochef"
        target="_blank"
        rel="noreferrer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.426 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.009-.868-.014-1.703-2.782.605-3.37-1.343-3.37-1.343-.454-1.154-1.11-1.461-1.11-1.461-.908-.62.069-.608.069-.608 1.003.07 1.531 1.031 1.531 1.031.892 1.53 2.341 1.088 2.91.833.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.748-1.027 2.748-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.847-2.338 4.695-4.566 4.943.359.31.678.92.678 1.855 0 1.338-.012 2.419-.012 2.748 0 .268.18.58.688.482A10.025 10.025 0 0 0 22 12.017C22 6.484 17.523 2 12 2Z" clip-rule="evenodd" />
        </svg>
        View on GitHub
      </a>
    </div>
  </div>
</div>

<script>
  // Mobile menu functionality
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menuClose = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-menu-overlay');

  function openMenu() {
    menu?.classList.add('open');
    overlay?.classList.add('open');
    menuBtn?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.remove('open');
    overlay?.classList.remove('open');
    menuBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  // Close menu when clicking a link
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) {
      closeMenu();
    }
  });

  // Scroll-state: bar shifts from frosted-white to teal once the user scrolls
  // past the hero. Uses requestAnimationFrame to coalesce updates.
  const nav = document.getElementById('main-nav');
  let ticking = false;
  function updateNavStyle() {
    if (!nav) return;
    if (window.scrollY > 50) {
      nav.classList.add('scrolled');
    } else {
      nav.classList.remove('scrolled');
    }
    ticking = false;
  }
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(updateNavStyle);
      ticking = true;
    }
  }, { passive: true });
  updateNavStyle();
</script>
