---
// Demo player for the Workflow page. Shows a short, light, silent loop as an
// ambient preview (autoplays, ~0.5 MB) and swaps to the full 5:45 walkthrough
// with sound + controls when the visitor clicks. Two files in public/video:
//   demo-loop.mp4  — 720p/30fps, muted, ~31s sped-up loop of the opening,
//                    web-optimized
//   demo.mp4       — full 1080p/60fps walkthrough with audio
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const loopSrc = withBase('/video/demo-loop.mp4');
const fullSrc = withBase('/video/demo.mp4');
const poster = withBase('/video/demo-poster.jpg');
---

<figure class="demo-player max-w-4xl mx-auto" id="workflow-demo">
  <div class="relative rounded-xl overflow-hidden border border-border shadow-card bg-black aspect-video">
    <!-- Ambient looping preview: silent, autoplays, repeats -->
    <video
      id="demo-loop"
      class="w-full h-full object-cover"
      src={loopSrc}
      poster={poster}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-label="BioChef workflow editor demo, silent preview"
    ></video>

    <!-- Full walkthrough, injected/revealed on click -->
    <video
      id="demo-full"
      class="absolute inset-0 w-full h-full object-contain bg-black hidden"
      src={fullSrc}
      poster={poster}
      controls
      playsinline
      preload="none"
      aria-label="BioChef workflow editor demo, full walkthrough"
    ></video>

    <!-- Click target + play affordance over the loop -->
    <button
      id="demo-play"
      type="button"
      class="absolute inset-0 flex items-center justify-center group focus:outline-none focus-visible:ring-2 focus-visible:ring-white/80 focus-visible:ring-inset"
      aria-label="Play the full demo with sound"
    >
      <span class="absolute inset-0 bg-gradient-to-t from-black/45 via-black/5 to-black/10 transition-opacity duration-200 group-hover:from-black/55"></span>
      <span class="relative flex items-center gap-3 px-5 py-3 rounded-full bg-white/95 text-text shadow-card-hover backdrop-blur transition-transform duration-200 group-hover:scale-[1.03]">
        <svg class="w-5 h-5 text-brand" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        <span class="text-sm font-medium tracking-tight">Watch full demo</span>
        <span class="font-mono text-xs text-text-tertiary">5:45</span>
      </span>
    </button>
  </div>

  <figcaption class="mt-3 text-center text-xs text-text-tertiary">
    Silent preview, sped up. Press play for the full walkthrough with audio, or
    <a class="text-brand hover:text-brand-dark" href={fullSrc} target="_blank" rel="noreferrer">open the video in a new tab</a>.
  </figcaption>
</figure>

<script>
  const root = document.getElementById('workflow-demo');
  if (root) {
    const loop = root.querySelector('#demo-loop') as HTMLVideoElement | null;
    const full = root.querySelector('#demo-full') as HTMLVideoElement | null;
    const playBtn = root.querySelector('#demo-play') as HTMLButtonElement | null;

    playBtn?.addEventListener('click', () => {
      if (!full || !loop) return;
      // Pause the ambient loop and hand the stage to the full walkthrough.
      loop.pause();
      loop.classList.add('hidden');
      playBtn.classList.add('hidden');
      full.classList.remove('hidden');
      full.currentTime = 0;
      full.play().catch(() => {
        /* Autoplay-with-sound can be blocked; controls are visible so the
           visitor can start it manually. */
      });
    });

    // When the full video ends, return to the looping preview.
    full?.addEventListener('ended', () => {
      if (!loop) return;
      full.classList.add('hidden');
      loop.classList.remove('hidden');
      playBtn?.classList.remove('hidden');
      loop.play().catch(() => {});
    });
  }
</script>
