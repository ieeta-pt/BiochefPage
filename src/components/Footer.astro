---
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const brandLogo = withBase('/img/biochef-logo.png');
const logoIeeta = withBase('/img/logo-ieeta.webp');
const logoUa = withBase('/img/logo-ua.webp');

const navGroups = [
  {
    title: 'Product',
    links: [
      { label: 'Why BioChef', href: '/why' },
      { label: 'Architecture', href: '/architecture' },
      { label: 'Workflows', href: '/workflows' }
    ]
  },
  {
    title: 'Developers',
    links: [
      { label: 'Getting Started', href: '/developers' },
      { label: 'Community', href: '/community' },
      { label: 'BioChef on GitHub', href: 'https://github.com/ieeta-pt/Biochef', external: true },
      { label: 'biochef-hub', href: 'https://github.com/ieeta-pt/biochef-hub', external: true }
    ]
  },
  {
    title: 'Resources',
    links: [
      { label: 'Live app', href: 'https://ieeta-pt.github.io/Biochef/', external: true },
      { label: 'Registry', href: 'https://registry.biochef.app', external: true },
      { label: 'Roadmap', href: '/community' }
    ]
  }
];

const year = new Date().getFullYear();
---

<footer class="bg-background border-t border-border">
  <div class="container-main py-14 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8">
      {/* Brand column */}
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-5">
          <div class="relative">
            <div class="absolute inset-0 rounded-xl bg-brand/10 blur-lg"></div>
            <img
              src={brandLogo}
              alt="BioChef"
              class="relative h-12 w-12 rounded-xl"
              width="48"
              height="48"
              loading="lazy"
            />
          </div>
          <span class="text-2xl font-bold text-brand tracking-tight">BioChef</span>
        </div>
        <p class="text-sm text-text-secondary mb-7 max-w-sm leading-relaxed">
          Signed, composable bioinformatics tools that run in your browser via WebAssembly. From recipes to registry.
        </p>

        {/* Partners — logos are white-on-transparent source files, so we paint the shape via SVG mask
            on a transparent background. Same trick as the nav-logo-mark. */}
        <div class="flex flex-wrap items-center gap-4">
          <span class="text-[10px] text-text-tertiary font-semibold uppercase tracking-[0.12em]">Built at</span>
          <div class="flex items-center gap-5">
            <a
              href="https://www.ieeta.pt/"
              target="_blank"
              rel="noreferrer"
              class="group inline-flex items-center justify-center"
              aria-label="IEETA"
              title="IEETA · Instituto de Engenharia Eletrónica e Informática de Aveiro"
            >
              <span
                class="partner-mark partner-mark--ieeta"
                style={`--mark-url: url(${logoIeeta})`}
                aria-hidden="true"
              ></span>
            </a>
            <a
              href="https://www.ua.pt/"
              target="_blank"
              rel="noreferrer"
              class="group inline-flex items-center justify-center"
              aria-label="Universidade de Aveiro"
              title="Universidade de Aveiro"
            >
              <span
                class="partner-mark partner-mark--ua"
                style={`--mark-url: url(${logoUa})`}
                aria-hidden="true"
              ></span>
            </a>
          </div>
        </div>
      </div>

      {/* Nav columns */}
      {navGroups.map((group) => (
        <div>
          <h3 class="text-[11px] text-text-tertiary font-semibold uppercase tracking-[0.12em] mb-4">{group.title}</h3>
          <ul class="space-y-2.5">
            {group.links.map((link) => (
              <li>
                <a
                  class="group text-sm text-text-secondary hover:text-text transition-colors duration-200 inline-flex items-center gap-1.5"
                  href={link.external ? link.href : withBase(link.href)}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noreferrer' : undefined}
                >
                  <span class="relative">
                    {link.label}
                    <span class="absolute bottom-0 left-0 w-0 h-px bg-text transition-all duration-200 group-hover:w-full"></span>
                  </span>
                  {link.external && (
                    <svg class="w-3 h-3 opacity-40 group-hover:opacity-90 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  {/* Bottom bar */}
  <div class="border-t border-border/60">
    <div class="container-main py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-text-tertiary text-center sm:text-left">
        <span>&copy; {year} BioChef Project</span>
        <span class="mx-2 opacity-40">·</span>
        <span>MIT</span>
        <span class="mx-2 opacity-40">·</span>
        <a
          class="hover:text-text transition-colors"
          href={withBase('/community#cite')}
        >Cite this work</a>
      </p>
      <a
        class="group inline-flex items-center justify-center p-2 rounded-lg text-text-secondary hover:text-text hover:bg-surface transition-all duration-200"
        href="https://github.com/ieeta-pt/Biochef"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.426 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.009-.868-.014-1.703-2.782.605-3.37-1.343-3.37-1.343-.454-1.154-1.11-1.461-1.11-1.461-.908-.62.069-.608.069-.608 1.003.07 1.531 1.031 1.531 1.031.892 1.53 2.341 1.088 2.91.833.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.748-1.027 2.748-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.847-2.338 4.695-4.566 4.943.359.31.678.92.678 1.855 0 1.338-.012 2.419-.012 2.748 0 .268.18.58.688.482A10.025 10.025 0 0 0 22 12.017C22 6.484 17.523 2 12 2Z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>
</footer>
