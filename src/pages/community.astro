---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import RoadmapTimeline from '../components/RoadmapTimeline';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<BaseLayout title="Community · BioChef">
  <PageHero
    kicker="Community"
    title="Community & Roadmap"
    subtitle="Track project progress, explore what is coming next, and meet the team behind BioChef."
    crumbs={[{ label: 'Community / Roadmap' }]}
    meta={[
      { label: 'Live since', value: '2024 (web app) · 2025 (Hub)' },
      { label: 'Built by', value: 'IEETA · University of Aveiro' },
      { label: 'License', value: 'MIT (code) · CC-BY 4.0 (paper)' }
    ]}
  />

  <!-- Project Status -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="Status"
        title="Project status"
        subtitle="The web app, Hub CI, and Registry are live today. Agent mode and workflow aggregation are in active development. Federated learning is on the longer roadmap."
      />

      <div class="grid-3">
        <article class="bg-surface rounded-xl border border-border border-l-4 border-l-brand p-6 md:p-7 shadow-card hover:shadow-card-hover transition-shadow duration-200">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-2.5 h-2.5 rounded-full bg-brand"></span>
            <span class="text-[10px] font-semibold tracking-[0.12em] uppercase text-brand">Live</span>
          </div>
          <h3 class="text-lg font-medium text-text mb-2 tracking-tight">BioChef web app</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Tools page + Workflow page; bioinformatics tools (GTO and others) running in WebAssembly via biowasm.</p>
        </article>

        <article class="bg-surface rounded-xl border border-border border-l-4 border-l-brand p-6 md:p-7 shadow-card hover:shadow-card-hover transition-shadow duration-200">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-2.5 h-2.5 rounded-full bg-brand"></span>
            <span class="text-[10px] font-semibold tracking-[0.12em] uppercase text-brand">Live</span>
          </div>
          <h3 class="text-lg font-medium text-text mb-2 tracking-tight">biochef-hub + Registry</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Reusable GitHub workflow signs and publishes recipes to <code>registry.biochef.app</code>.</p>
        </article>

        <article class="bg-surface rounded-xl border border-border border-l-4 border-l-accent p-6 md:p-7 shadow-card hover:shadow-card-hover transition-shadow duration-200">
          <div class="flex items-center gap-2 mb-3">
            <span class="relative flex h-2.5 w-2.5">
              <span class="absolute inline-flex h-full w-full rounded-full bg-accent opacity-60 animate-ping"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent"></span>
            </span>
            <span class="text-[10px] font-semibold tracking-[0.12em] uppercase text-accent-dark">In development</span>
          </div>
          <h3 class="text-lg font-medium text-text mb-2 tracking-tight">Agent mode &amp; workflow aggregation</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Server-side execution of signed bundles outside the browser, plus packaging multi-step workflows as first-class registry artifacts.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Roadmap -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="Roadmap"
        title="What is next"
        subtitle="Planned milestones and current progress."
      />

      <div class="max-w-2xl mx-auto">
        <div class="card card-padding">
          <RoadmapTimeline
            client:visible
            items={[
              {
                id: 'spa',
                label: 'BioChef web app: Tools + Workflow pages',
                description: 'A growing catalogue of bioinformatics tools (GTO and others) compiled to WebAssembly, in-browser DAG editor, recipe persistence. Live at ieeta-pt.github.io/Biochef.',
                status: 'done'
              },
              {
                id: 'hub',
                label: 'biochef-hub CI + signed Registry',
                description: 'Reusable GitHub workflow that validates, builds, signs (cosign), and publishes bundles to registry.biochef.app.',
                status: 'done'
              },
              {
                id: 'recipes',
                label: 'biochef-recipes catalog growth',
                description: 'Expand the public recipe catalogue with more tools, more contributors, and richer metadata.',
                status: 'in-progress'
              },
              {
                id: 'agent',
                label: 'Agent mode',
                description: 'Server-side and desktop runtime that executes signed bundles outside the browser, with the same provenance guarantees. In active development.',
                status: 'in-progress'
              },
              {
                id: 'aggregation',
                label: 'Workflow aggregation',
                description: 'Package multi-step workflows as first-class signed artifacts in the registry, alongside individual tools, so a whole pipeline becomes a single shareable recipe.',
                status: 'planned'
              },
              {
                id: 'fl',
                label: 'Federated learning + server runtimes',
                description: 'Federated Aggregator + Silo Agents, GA4GH connectors, WES/TES, MCP gateway, observability. All designed but not yet shipped.',
                status: 'planned'
              }
            ]}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Team & Citation -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="Team"
        title="Who builds BioChef"
        subtitleHtml='A research team at <a class="text-brand hover:text-brand-dark" href="https://www.ieeta.pt/" target="_blank" rel="noreferrer">IEETA</a>, <a class="text-brand hover:text-brand-dark" href="https://www.ua.pt/" target="_blank" rel="noreferrer">University of Aveiro</a>.'
      />

      {/* Three tiered groups: active development, supervision, past contributors */}
      <div class="max-w-5xl mx-auto space-y-12 mb-16">
        {[
          {
            kicker: 'Active development',
            members: [
              { initials: 'JA', name: 'João Andrade', role: 'Lead developer', tone: 'brand', active: true },
              { initials: 'MR', name: 'Miguel Reis', role: 'Developer', tone: 'brand', active: false }
            ]
          },
          {
            kicker: 'Project leadership',
            members: [
              { initials: 'JS', name: 'Jorge Miguel Silva', role: 'Project lead · IEETA', tone: 'accent', active: false, url: 'https://jorgemfs.com', photo: '/img/team/jorge-miguel-silva.webp' },
              { initials: 'JO', name: 'José Luis Oliveira', role: 'Supervisor · IEETA', tone: 'accent', active: false, photo: '/img/team/jose-luis-oliveira.png' }
            ]
          },
          {
            kicker: 'Past contributors',
            members: [
              { initials: 'JR', name: 'Joaquim Rosa', role: 'Original author of the BioChef SPA', tone: 'neutral', active: false, url: 'https://github.com/JakeRosa', photo: '/img/team/joaquim-rosa.png' }
            ]
          }
        ].map((group) => (
          <div>
            <div class="flex items-center gap-4 mb-5">
              <span class="inline-flex h-px w-10 bg-border"></span>
              <p class="text-[11px] font-semibold tracking-[0.12em] uppercase text-text-tertiary">{group.kicker}</p>
              <span class="inline-flex h-px flex-1 bg-border/60"></span>
            </div>

            <div class="grid sm:grid-cols-2 gap-4 md:gap-5">
              {group.members.map((person) => {
                const isAccent = person.tone === 'accent';
                const isNeutral = person.tone === 'neutral';
                const ruleClass = isNeutral ? 'bg-border' : isAccent ? 'bg-accent' : 'bg-brand';
                const ringClass = isNeutral ? 'border-border' : isAccent ? 'border-accent/30' : 'border-brand/30';
                const tileClass = isNeutral ? 'bg-background' : isAccent ? 'bg-accent-light' : 'bg-brand-light';
                const monoClass = isNeutral ? 'text-text-tertiary' : isAccent ? 'text-accent-dark' : 'text-brand-dark';
                return (
                  <article class={`group relative card overflow-hidden transition-shadow duration-300 hover:shadow-card-hover ${isNeutral ? 'opacity-95' : ''}`}>
                    {/* tone hairline */}
                    <div class={`absolute top-0 left-0 right-0 h-[3px] ${ruleClass} ${isNeutral ? 'opacity-60' : 'opacity-90'}`}></div>

                    <div class="flex items-center gap-5 p-5 md:p-6">
                      {/* Photo (when supplied) or monogram fallback. The dashed
                          tone-tinted ring stays in both cases for visual continuity. */}
                      <div class="relative flex-shrink-0 w-16 h-16 flex items-center justify-center">
                        <div class={`absolute inset-0 rounded-full border border-dashed ${ringClass}`}></div>
                        {person.photo ? (
                          <div class="absolute inset-1.5 rounded-full overflow-hidden bg-background">
                            <img
                              src={withBase(person.photo)}
                              alt={person.name}
                              class="w-full h-full object-cover"
                              width="52"
                              height="52"
                              loading="lazy"
                            />
                          </div>
                        ) : (
                          <>
                            <div class={`absolute inset-1.5 rounded-full ${tileClass}`}></div>
                            <span class={`relative font-mono text-lg font-semibold tracking-tight ${monoClass}`}>{person.initials}</span>
                          </>
                        )}
                        {person.active && (
                          <span class="absolute -top-0.5 -right-0.5 inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500 ring-2 ring-surface" title="Active developer"></span>
                        )}
                      </div>

                      {/* identity + role */}
                      <div class="min-w-0 flex-1">
                        <h3 class="font-semibold text-text text-base md:text-lg tracking-tight mb-1 leading-tight">
                          {person.url ? (
                            <a
                              href={person.url}
                              target="_blank"
                              rel="noreferrer"
                              class="inline-flex items-center gap-1.5 hover:text-brand transition-colors group/link"
                            >
                              {person.name}
                              <svg class="w-3.5 h-3.5 text-text-tertiary group-hover/link:text-brand transition-colors flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M7 17 17 7" />
                                <path d="M7 7h10v10" />
                              </svg>
                            </a>
                          ) : (
                            person.name
                          )}
                        </h3>
                        <p class={`text-sm leading-snug ${isNeutral ? 'text-text-tertiary' : 'text-text-secondary'}`}>{person.role}</p>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <article id="cite" class="bg-surface rounded-xl border border-border border-l-4 border-l-tertiary p-6 md:p-8 shadow-card max-w-3xl mx-auto scroll-mt-32 hover:shadow-card-hover transition-shadow duration-200">
        <p class="text-[10px] font-semibold tracking-[0.12em] text-tertiary uppercase mb-3">Cite this work</p>
        <h3 class="text-lg font-medium text-text mb-2 tracking-tight">Published in BMC Bioinformatics · 2026</h3>
        <p class="text-sm text-text-secondary mb-4 leading-relaxed">
          Rosa, J., Andrade, J., Silva, J. M., &amp; Oliveira, J. L. (2026).
          <strong>Biochef: a client-side WebAssembly-based workflow builder for genomic data analysis.</strong>
          <em>BMC Bioinformatics.</em> DOI:
          <a class="text-brand hover:text-brand-dark font-medium" href="https://doi.org/10.1186/s12859-026-06431-1" target="_blank" rel="noreferrer">10.1186/s12859-026-06431-1</a>
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary text-sm" href="https://doi.org/10.1186/s12859-026-06431-1" target="_blank" rel="noreferrer">Read on BMC Bioinformatics</a>
          <a class="btn btn-secondary text-sm" href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noreferrer">CC-BY 4.0</a>
        </div>
        <p class="mt-4 text-xs text-text-tertiary">Open access. BioChef code is released under the MIT License.</p>
      </article>
    </div>
  </section>

  <!-- Get Involved -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="Get involved"
        title="Join the project"
        subtitle="Open issues, discuss ideas, or open a pull request. Everything happens on GitHub."
      />

      <div class="grid-3">
        <article class="bg-surface rounded-xl border border-border border-l-4 border-l-brand p-6 md:p-7 shadow-card hover:shadow-card-hover transition-shadow duration-200">
          <div class="inline-flex items-center justify-center w-10 h-10 mb-4 text-brand">
            <svg class="w-6 h-6 text-brand" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </div>
          <h3 class="font-semibold text-text mb-3">Repositories</h3>
          <ul class="space-y-2">
            <li>
              <a
                class="text-sm text-text-secondary hover:text-brand transition-colors inline-flex items-center gap-1"
                href="https://github.com/ieeta-pt/Biochef"
                target="_blank"
                rel="noreferrer"
              >
                ieeta-pt/Biochef
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </li>
            <li>
              <a
                class="text-sm text-text-secondary hover:text-brand transition-colors inline-flex items-center gap-1"
                href="https://github.com/ieeta-pt/biochef-hub"
                target="_blank"
                rel="noreferrer"
              >
                ieeta-pt/biochef-hub
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </li>
            <li>
              <a
                class="text-sm text-text-secondary hover:text-brand transition-colors inline-flex items-center gap-1"
                href="https://registry.biochef.app"
                target="_blank"
                rel="noreferrer"
              >
                registry.biochef.app
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </li>
          </ul>
        </article>

        <article class="bg-surface rounded-xl border border-border border-l-4 border-l-brand p-6 md:p-7 shadow-card hover:shadow-card-hover transition-shadow duration-200">
          <div class="inline-flex items-center justify-center w-10 h-10 mb-4 text-brand">
            <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <h3 class="font-semibold text-text mb-3">Issues &amp; Discussions</h3>
          <ul class="space-y-2">
            <li>
              <a class="text-sm text-text-secondary hover:text-brand transition-colors inline-flex items-center gap-1" href="https://github.com/ieeta-pt/Biochef/issues" target="_blank" rel="noreferrer">
                BioChef issues
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              </a>
            </li>
            <li>
              <a class="text-sm text-text-secondary hover:text-brand transition-colors inline-flex items-center gap-1" href="https://github.com/ieeta-pt/biochef-hub/issues" target="_blank" rel="noreferrer">
                biochef-hub issues
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              </a>
            </li>
          </ul>
        </article>

        <article class="bg-surface rounded-xl border border-border border-l-4 border-l-brand p-6 md:p-7 shadow-card hover:shadow-card-hover transition-shadow duration-200">
          <div class="inline-flex items-center justify-center w-10 h-10 mb-4 text-brand">
            <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="font-semibold text-text mb-3">Contributing</h3>
          <p class="text-sm text-text-secondary mb-3">
            See <code>CONTRIBUTING.md</code> in the BioChef repo for code style, build, and test guidance.
          </p>
          <a class="text-sm text-brand hover:text-brand-dark font-medium inline-flex items-center gap-1" href="https://github.com/ieeta-pt/Biochef/blob/main/CONTRIBUTING.md" target="_blank" rel="noreferrer">
            Read CONTRIBUTING.md
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
