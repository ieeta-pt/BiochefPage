---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';

// News & Events feed. To add an item, prepend an object to `news` (keep the
// list newest-first). `category` picks the accent tone; `href`/`cta` are
// optional; set `featured: true` to elevate one card (used for the paper).
const toneClasses = {
  brand:     { rule: 'border-l-brand',     badge: 'bg-brand/10 text-brand' },
  accent:    { rule: 'border-l-accent',    badge: 'bg-accent/10 text-accent' },
  tertiary:  { rule: 'border-l-tertiary',  badge: 'bg-tertiary/10 text-tertiary' },
  secondary: { rule: 'border-l-secondary', badge: 'bg-secondary/10 text-secondary' }
};

const news = [
  {
    dateLabel: '8 July 2026',
    category: 'Talk',
    tone: 'brand',
    title: 'BioChef presented to the ELIXIR hCNV Community',
    location: 'Erasmus MC, Rotterdam · F2F / hybrid meeting',
    summary:
      'Jorge Silva presented BioChef at the ELIXIR human Copy Number Variation (hCNV) Community face-to-face meeting, discussing use-case workflows, benchmarking, and how a browser-native, signed toolchain can serve the wider ELIXIR human data communities.',
    href: 'https://cnvar.org/',
    cta: 'About the hCNV Community →',
    featured: false
  },
  {
    dateLabel: '30 June 2026',
    category: 'Milestone',
    tone: 'secondary',
    title: 'João Andrade defends his MSc thesis on BioChef',
    location: 'University of Aveiro · MSc in Informatics Engineering',
    summary:
      'BioChef lead developer João Andrade defended his MSc dissertation, <em>“Uma plataforma web client-side baseada em plug-ins para execução híbrida de workflows”</em> (a client-side, plug-in-based web platform for hybrid workflow execution) — the architecture behind BioChef. Supervised by José Luís Oliveira and Jorge Miguel Silva (IEETA, University of Aveiro).',
    // Points to the UA DETI dissertations collection for now; swap to the
    // direct RIA handle once the thesis is deposited and indexed.
    href: 'https://ria.ua.pt/handle/10773/244',
    cta: 'University of Aveiro · DETI dissertations →',
    featured: false
  },
  {
    dateLabel: '18 May 2026',
    category: 'Talk',
    tone: 'brand',
    title: 'BioChef presented at the BioData.pt | ELIXIR-PT Technical Meeting 2026',
    location: 'INESC-ID, Lisbon',
    summary:
      'Jorge Silva and João Andrade (IEETA, University of Aveiro) introduced BioChef in a two-hour session at the 7th annual BioData.pt | ELIXIR-PT Technical Meeting, which gathered 31 participants. The 2026 edition put AI and machine learning at the heart of the agenda, with hands-on work on Deucalion, the Portuguese national supercomputer.',
    href: 'https://biodata.pt/news/biodatapt-elixir-pt-technical-meeting',
    cta: 'Read the write-up on biodata.pt →',
    featured: false
  },
  {
    dateLabel: '9 April 2026',
    category: 'Publication',
    tone: 'tertiary',
    title: 'BioChef published in BMC Bioinformatics',
    location: 'BMC Bioinformatics 27:103 · Open access · CC-BY 4.0',
    summary:
      'The peer-reviewed paper describing BioChef — a client-side, WebAssembly-based workflow builder for genomic data analysis — is out in BMC Bioinformatics. Rosa, J., Andrade, J., Silva, J. M., &amp; Oliveira, J. L. (2026). <em>Biochef: a client-side WebAssembly-based workflow builder for genomic data analysis.</em> BMC Bioinformatics 27, 103.',
    href: 'https://doi.org/10.1186/s12859-026-06431-1',
    cta: 'Read on BMC Bioinformatics →',
    featured: true
  },
  {
    dateLabel: '22 October 2025',
    category: 'Preprint',
    tone: 'accent',
    title: 'BioChef preprint posted on Research Square',
    location: 'Preprint · v1',
    summary:
      'The first public write-up of BioChef went online as a Research Square preprint ahead of peer review — the client-side, WebAssembly-based approach to running genomic workflows entirely in the browser.',
    href: 'https://doi.org/10.21203/rs.3.rs-7697498/v1',
    cta: 'Read the preprint →',
    featured: false
  }
];
---

<BaseLayout
  title="News & Events · BioChef"
  description="Milestones, talks, and publications from the BioChef project — the browser-native, signed bioinformatics platform from IEETA, University of Aveiro."
>
  <PageHero
    kicker="News & Events"
    title="News &amp; Events"
    subtitle="Publications, talks, and milestones from the BioChef project. Follow along as the browser-native, signed bioinformatics platform grows."
    crumbs={[{ label: 'News & Events' }]}
    meta={[
      { label: 'Latest', value: 'BMC Bioinformatics paper' },
      { label: 'From', value: 'IEETA · University of Aveiro' }
    ]}
  />

  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="Latest first"
        title="What's happening"
        subtitle="Peer-reviewed publications, conference talks, and project milestones, most recent at the top."
      />

      <ol class="max-w-3xl mx-auto space-y-5">
        {news.map((item) => {
          const tone = toneClasses[item.tone] ?? toneClasses.brand;
          return (
            <li>
              <article
                class={`bg-surface rounded-xl border border-border border-l-4 ${tone.rule} p-6 md:p-8 shadow-card hover:shadow-card-hover transition-shadow duration-200 ${item.featured ? 'ring-1 ring-brand/15' : ''}`}
              >
                <div class="flex flex-wrap items-center gap-3 mb-3">
                  <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-[0.1em] ${tone.badge}`}>
                    {item.category}
                  </span>
                  <time class="font-mono text-xs text-text-tertiary">{item.dateLabel}</time>
                  {item.location && (
                    <span class="text-xs text-text-tertiary">· {item.location}</span>
                  )}
                  {item.featured && (
                    <span class="ml-auto text-[10px] font-semibold uppercase tracking-[0.1em] text-brand">Featured</span>
                  )}
                </div>

                <h3 class="text-lg md:text-xl font-medium text-text tracking-tight mb-2">{item.title}</h3>
                <p class="text-sm text-text-secondary leading-relaxed" set:html={item.summary}></p>

                {item.href && (
                  <a
                    class="inline-flex items-center gap-1 mt-4 text-sm font-medium text-brand hover:text-brand-dark"
                    href={item.href}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {item.cta ?? 'Read more →'}
                  </a>
                )}
              </article>
            </li>
          );
        })}
      </ol>

      <p class="text-center text-xs text-text-tertiary mt-10">
        Presented or wrote about BioChef somewhere? <a class="text-brand hover:text-brand-dark" href="https://github.com/ieeta-pt/Biochef/issues" target="_blank" rel="noreferrer">Open an issue</a> and we'll add it here.
      </p>
    </div>
  </section>
</BaseLayout>
