---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

// Hands-on tutorial. Every step, screenshot and expected result was checked in
// the live app (biochef.app) with the files in public/tutorials/map-reads.
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const img = (name: string) => withBase(`/img/tutorials/map-reads/${name}.webp`);
const file = (name: string) => withBase(`/tutorials/map-reads/${name}`);

const title = 'Map sequencing reads to a reference in your browser';
const description =
  'A 20-minute hands-on tutorial: build a BioChef workflow that aligns reads with minimap2, sorts them with samtools and reports how many mapped, all in the browser with nothing to install.';

const steps = [
  {
    title: 'Open the Workflow Builder',
    body: 'Go to <a href="https://biochef.app/" target="_blank" rel="noreferrer">biochef.app</a> and choose <strong>Workflow Builder</strong> in the top bar. If a short tour opens, close it. The canvas starts with one <strong>Input</strong> node.',
    image: null
  },
  {
    title: 'Load the two files',
    body: 'In the right-hand panel, open <strong>File manager</strong> and upload <code>phix174.fasta</code> and <code>reads.fastq</code>. They are read by your browser; nothing is sent to a server.',
    image: { name: '01-upload', alt: 'The File manager panel listing reads.fastq and phix174.fasta after upload.' }
  },
  {
    title: 'Give the reads to the Input node',
    body: 'With the Input node selected, tick <code>reads.fastq</code>. The tool list on the left now shows only the tools that accept FASTQ.',
    image: { name: '02-filtered', alt: 'reads.fastq ticked; the tool list shows FASTQ tools such as fastp, seqtk and GTO.' }
  },
  {
    title: 'Add the aligner',
    body: 'Type <code>minimap</code> in <strong>Search Operations</strong> and click <strong>Align (minimap2)</strong>. A new node appears with two inputs, <em>ref</em> and <em>reads</em>. Drag from the dot under the Input node to the <em>reads</em> dot.',
    image: { name: '03-align-reads', alt: 'Input node connected to the reads input of the Align (minimap2) node by a line labelled FASTQ.' }
  },
  {
    title: 'Add the reference',
    body: 'Click <strong>Add input node</strong>, select the new node and tick <code>phix174.fasta</code>. Connect it to the <em>ref</em> dot. Each connection is labelled with the file type it carries: FASTA for the reference, FASTQ for the reads.',
    image: { name: '04-reference', alt: 'Two Input nodes connected to Align (minimap2): FASTA into ref and FASTQ into reads.' }
  },
  {
    title: 'Ask minimap2 for SAM output',
    body: 'Click the Align node and switch on <strong>sam_output</strong> (minimap2’s <code>-a</code> option). Without it, minimap2 writes PAF text, which samtools cannot read.',
    image: { name: '05-sam-output', alt: 'The Align (minimap2) settings with the sam_output switch turned on.' }
  },
  {
    title: 'Sort and summarise the alignments',
    body: 'With the Align node selected, search <code>sort</code> and add <strong>Sort (samtools)</strong>; connect Align to its <em>in</em> dot. Then add <strong>Flagstat (samtools)</strong> and connect Sort to it. Finally click <strong>Add output node</strong> and connect Flagstat to the Output.',
    image: { name: '06-workflow', alt: 'The finished workflow: two inputs, Align (minimap2), Sort (samtools), Flagstat (samtools) and Output, with connections labelled FASTA, FASTQ, SAM, BAM and TEXT.' }
  },
  {
    title: 'Run it and read the result',
    body: 'Click the green <strong>▶</strong> button at the top left of the workflow. It takes a few seconds. Click the <strong>Output</strong> node to see the flagstat report.',
    image: { name: '07-result', alt: 'The Output panel showing samtools flagstat: 400 reads in total, 380 mapped (95.00%).' }
  }
];
---

<BaseLayout title={`${title} · BioChef`} description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    'dct:conformsTo': { '@type': 'CreativeWork', '@id': 'https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE' },
    name: title,
    description,
    url: 'https://home.biochef.app/tutorials/map-reads/',
    keywords: ['read mapping', 'minimap2', 'samtools', 'WebAssembly', 'workflow', 'genomics'],
    learningResourceType: 'hands-on tutorial',
    educationalLevel: 'Beginner',
    timeRequired: 'PT20M',
    inLanguage: 'en',
    license: 'https://creativecommons.org/licenses/by/4.0/',
    teaches: [
      'Build a workflow in the BioChef editor',
      'Align reads to a reference with minimap2',
      'Sort alignments and summarise them with samtools',
      'Export and import a workflow file'
    ],
    mentions: { '@type': 'SoftwareApplication', name: 'BioChef', url: 'https://biochef.app', sameAs: 'https://bio.tools/biochef' },
    author: [{ '@type': 'Organization', name: 'IEETA, University of Aveiro', url: 'https://www.ieeta.pt' }]
  })} />

  <PageHero
    kicker="Tutorial"
    title="Map sequencing reads in your browser"
    subtitle="Build a workflow that aligns reads to a reference with minimap2, sorts them with samtools and reports how many mapped. Everything runs in your browser; nothing is installed or uploaded."
    crumbs={[{ label: 'Workflows', href: withBase('/workflows') }, { label: 'Tutorial: map reads' }]}
    meta={[
      { label: 'Level', value: 'Beginner, no command line needed' },
      { label: 'Time', value: 'About 20 minutes' },
      { label: 'You need', value: 'A recent desktop browser' },
      { label: 'Licence', value: 'CC BY 4.0' }
    ]}
  />

  <section class="section">
    <div class="container-main max-w-3xl">
      <div class="grid gap-8 md:grid-cols-2">
        <div>
          <h2 class="text-2xl font-medium text-text tracking-tight">What you will learn</h2>
          <ul class="mt-4 space-y-2 text-text-secondary leading-relaxed list-disc pl-5">
            <li>Build a workflow by connecting tools in the BioChef editor</li>
            <li>Align reads to a reference with minimap2</li>
            <li>Sort the alignments and summarise them with samtools</li>
            <li>Save the workflow as a file and open it again</li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl font-medium text-text tracking-tight">The data</h2>
          <p class="mt-4 text-text-secondary leading-relaxed">
            The genome of bacteriophage PhiX174 (<a class="text-brand-dark underline underline-offset-2 hover:text-brand-800" href="https://www.ncbi.nlm.nih.gov/nuccore/NC_001422.1" target="_blank" rel="noreferrer">NC_001422.1</a>, 5,386 bp) and 400 simulated 150 bp reads: 380 copied from the genome with about 0.5% errors, and 20 random reads that should not map.
          </p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary text-sm" href={file('phix174.fasta')} download>Download phix174.fasta (5 KB)</a>
        <a class="btn btn-secondary text-sm" href={file('reads.fastq')} download>Download reads.fastq (126 KB)</a>
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container-main max-w-3xl">
      <h2 class="text-3xl font-medium text-text tracking-tight">Steps</h2>
      <ol class="mt-8 space-y-14">
        {steps.map((step, i) => (
          <li>
            <div class="grid grid-cols-[2.25rem_minmax(0,1fr)] gap-x-3">
              <span class="font-mono text-sm text-brand-dark pt-1">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-xl font-medium text-text tracking-tight">{step.title}</h3>
                <p class="tutorial-text mt-2 text-text-secondary leading-relaxed" set:html={step.body} />
              </div>
            </div>
            {step.image && (
              <figure class="mt-5">
                <div class="rounded-xl overflow-hidden border border-border bg-surface shadow-card">
                  <a href={img(step.image.name)} target="_blank" rel="noreferrer"><img src={img(step.image.name)} alt={step.image.alt} width="1200" height="750" loading="lazy" decoding="async" class="block w-full h-auto" /></a>
                </div>
              </figure>
            )}
          </li>
        ))}
      </ol>

      <div class="mt-12 bg-surface border border-border rounded-xl shadow-card p-6 md:p-8">
        <h3 class="text-lg font-medium text-text tracking-tight">What you should see</h3>
        <pre class="mt-4 overflow-x-auto rounded-lg bg-background p-4 font-mono text-[13px] leading-relaxed text-text">400 + 0 in total (QC-passed reads + QC-failed reads)
...
380 + 0 mapped (95.00% : N/A)</pre>
        <p class="mt-4 text-text-secondary leading-relaxed">
          380 of the 400 reads map: the 380 that came from PhiX174. The 20 random reads do not. If your numbers differ, check that <strong>sam_output</strong> is on and that the reference goes into <em>ref</em> and the reads into <em>reads</em>.
        </p>
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container-main max-w-3xl space-y-14">
      <div>
        <h2 class="text-2xl font-medium text-text tracking-tight">Look under the hood</h2>
        <p class="tutorial-text mt-3 text-text-secondary leading-relaxed">
          The small <strong>ⓘ</strong> on a node opens the tool’s own log. For minimap2 it shows the version (2.22-r1101), how many reads were mapped and the exact command that ran: the same tool you would run on a server, compiled to WebAssembly.
        </p>
        <figure class="mt-5">
          <div class="rounded-xl overflow-hidden border border-border bg-surface shadow-card">
            <a href={img('08-log')} target="_blank" rel="noreferrer"><img src={img('08-log')} alt="The log of Align (minimap2): index statistics, 400 sequences mapped, version 2.22-r1101 and the command line." width="1200" height="750" loading="lazy" decoding="async" class="block w-full h-auto" /></a>
          </div>
        </figure>
      </div>

      <div>
        <h2 class="text-2xl font-medium text-text tracking-tight">Save and share the workflow</h2>
        <p class="tutorial-text mt-3 text-text-secondary leading-relaxed">
          Click <strong>Export workflow</strong> to download it as one JSON file, and <strong>Import workflow</strong> to open it again, on any computer. The file also contains the data loaded in its Input nodes, so do not share it as it is if those files are sensitive.
        </p>
        <p class="mt-3 text-text-secondary leading-relaxed">
          Short on time? Import the finished workflow, data included, and press ▶.
        </p>
        <div class="mt-5">
          <a class="btn btn-secondary text-sm" href={file('map-reads-workflow.json')} download>Download the finished workflow (JSON)</a>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-medium text-text tracking-tight">Exercise: how much of the genome is covered?</h2>
        <p class="tutorial-text mt-3 text-text-secondary leading-relaxed">
          Select the Sort node and add <strong>Coverage (samtools)</strong>. Connect Sort to it, add a second Output node and run again. You should get one line for NC_001422.1 with <strong>380</strong> reads, <strong>99.16%</strong> of the genome covered and a mean depth of about <strong>10.6</strong>.
        </p>
        <details class="mt-5 bg-surface border border-border rounded-xl p-5">
          <summary class="cursor-pointer font-medium text-text">Show the solution</summary>
          <figure class="mt-4">
            <div class="rounded-xl overflow-hidden border border-border bg-surface">
              <a href={img('09-exercise')} target="_blank" rel="noreferrer"><img src={img('09-exercise')} alt="The workflow with a second branch: Sort feeds both Flagstat and Coverage (samtools); the coverage output shows 380 reads and 99.1645% coverage." width="1200" height="750" loading="lazy" decoding="async" class="block w-full h-auto" /></a>
            </div>
          </figure>
          <div class="mt-4">
            <a class="btn btn-secondary text-sm" href={file('map-reads-solution.json')} download>Download the solution workflow (JSON)</a>
          </div>
        </details>
      </div>

      <div>
        <h2 class="text-2xl font-medium text-text tracking-tight">From a test to a full run</h2>
        <p class="tutorial-text mt-3 text-text-secondary leading-relaxed">
          The browser is the place to build and test a workflow on small data like this. For full datasets, the same workflow file is meant to run next to the data with the <a href="https://github.com/ieeta-pt/biochef-agent" target="_blank" rel="noreferrer">BioChef agent</a>, which is in development. See <a href={withBase('/workflows')}>Workflows</a> for how the two fit together.
        </p>
      </div>

      <p class="text-sm text-text-tertiary leading-relaxed border-t border-border pt-6">
        This tutorial is licensed under <a class="text-brand-dark underline underline-offset-2 hover:text-brand-800" href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noreferrer">CC BY 4.0</a>. If you use BioChef in your work, please cite{' '}
        <a class="text-brand-dark underline underline-offset-2 hover:text-brand-800" href="https://doi.org/10.1186/s12859-026-06431-1" target="_blank" rel="noreferrer">Rosa et al., BMC Bioinformatics 2026</a>.
        BioChef is listed in bio.tools as <a class="text-brand-dark underline underline-offset-2 hover:text-brand-800" href="https://bio.tools/biochef" target="_blank" rel="noreferrer">biotools:biochef</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .tutorial-text :global(a) {
    color: var(--color-brand-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .tutorial-text :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    background: var(--color-brand-light);
    color: var(--color-brand-800);
  }
</style>
