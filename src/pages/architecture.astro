---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
// NOTE: ArchitectureShowcaseV3 (and SimpleArchitectureDiagram, ArchitectureDiagramV2…)
// remain on disk under src/components/ for the future-state architecture, but the
// production page renders an inline SVG that only depicts shipped components.
import RecipesHub from '../content/architecture/recipes-hub.mdx';
import RegistryCatalog from '../content/architecture/registry-catalog.mdx';
import UiWasm from '../content/architecture/ui-wasm-runtime.mdx';
// Flow MDX (tool-publication, standard-workflow, fl-session) are still on disk
// but no longer rendered: the anatomy diagram already narrates the same flows.
// NOTE: AgentRemote, Federated, Observability, Mcp, Ga4gh, LsAai, FlFlow MDX
// files still live under src/content/ but their imports are intentionally
// removed here — those subsystems are roadmap items, not shipped today.
---

<BaseLayout title="Architecture · BioChef">
  <PageHero
    kicker="Architecture"
    title="Anatomy of a BioChef tool"
    subtitle="Four pieces ship today: YAML recipes in Git, the Hub CI that signs and publishes, the BioChef Registry, and the static web app that runs every tool as WebAssembly in your browser."
    crumbs={[{ label: 'Architecture' }]}
    meta={[
      { label: 'Live components', value: 'Recipes · Hub · Registry · Web app' },
      { label: 'Build chain', value: 'Emscripten · biowasm · cosign' },
      { label: 'Distribution', value: '<code class="font-mono text-sm">registry.biochef.app</code>' }
    ]}
  />

  <!-- Shipped-today architecture diagram -->
  <section class="section-lg">
    <div class="container-main">
      <SectionHeader
        kicker="Shipped today"
        title="The path a tool travels"
        subtitle="Four stations, left to right. Every artifact is content-addressable; every step is signed."
      />

      {/* Mobile (<md): vertical 4-station card timeline. The big anatomy SVG
          below renders at viewBox 1280x500 and shrinks ~3.4× on a 375px phone,
          making its 9–17px text unreadable. This stacked equivalent tells the
          same four-station story at full type sizes. */}
      <div class="md:hidden space-y-3 max-w-md mx-auto">
        <article class="bg-surface rounded-xl border border-border border-l-4 border-l-accent p-5 shadow-card">
          <p class="text-[10px] font-semibold tracking-[0.12em] uppercase text-accent mb-2">01 · Source</p>
          <h3 class="text-base font-semibold text-text mb-1">biochef-recipes</h3>
          <p class="text-sm text-text-secondary">YAML source of truth. Each tool is a <code>biochef.yaml</code> file declaring inputs, runtime, and version.</p>
        </article>
        <div class="flex items-center justify-center gap-2 text-[10px] font-semibold tracking-[0.12em] uppercase text-accent">
          <span class="h-px w-6 bg-accent/40"></span>
          push
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m-7-7l7 7 7-7"/></svg>
        </div>

        <article class="bg-surface rounded-xl border border-border border-l-4 border-l-brand p-5 shadow-card">
          <p class="text-[10px] font-semibold tracking-[0.12em] uppercase text-brand mb-2">02 · Build</p>
          <h3 class="text-base font-semibold text-text mb-1">biochef-hub</h3>
          <p class="text-sm text-text-secondary">CI on GitHub Actions: validate, build to WASM, run golden tests, generate SBOM and SLSA, sign with cosign.</p>
        </article>
        <div class="flex items-center justify-center gap-2 text-[10px] font-semibold tracking-[0.12em] uppercase text-brand-dark">
          <span class="h-px w-6 bg-brand/40"></span>
          publish
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m-7-7l7 7 7-7"/></svg>
        </div>

        <article class="bg-surface rounded-xl border border-border border-l-4 border-l-brand-800 p-5 shadow-card">
          <p class="text-[10px] font-semibold tracking-[0.12em] uppercase text-brand-800 mb-2">03 · Distribute</p>
          <h3 class="text-base font-semibold text-text mb-1">BioChef Registry</h3>
          <p class="text-sm text-text-secondary">Content-addressable OCI bundles at <code>registry.biochef.app</code>: <code>bundle.json</code>, WASM/JS layers, SBOM, signature.</p>
        </article>
        <div class="flex items-center justify-center gap-2 text-[10px] font-semibold tracking-[0.12em] uppercase text-tertiary">
          <span class="h-px w-6 bg-tertiary/40"></span>
          fetch
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m-7-7l7 7 7-7"/></svg>
        </div>

        <article class="bg-surface rounded-xl border border-border border-l-4 border-l-tertiary p-5 shadow-card">
          <p class="text-[10px] font-semibold tracking-[0.12em] uppercase text-tertiary mb-2">04 · Runtime</p>
          <h3 class="text-base font-semibold text-text mb-1">BioChef web app</h3>
          <p class="text-sm text-text-secondary">Static SPA fetches tools by digest, verifies the signature, and runs them as WebAssembly inside your browser tab.</p>
        </article>

        <p class="text-center text-[11px] text-text-tertiary pt-2">Every artifact is content-addressable · every step is signed</p>
      </div>

      {/* Desktop / tablet view — the full inline SVG anatomy diagram. */}
      <div class="hidden md:block card overflow-hidden p-6 md:p-10">
        <svg
          viewBox="0 0 1280 500"
          class="w-full h-auto block"
          role="img"
          aria-label="BioChef tool journey across four stations: a YAML recipe in biochef-recipes is built and signed by biochef-hub on GitHub Actions, published as a content-addressable bundle to the BioChef Registry, then fetched by digest and run as WebAssembly inside the BioChef web app."
        >
          <defs>
            <!-- Lab-notebook dotted grid -->
            <pattern id="dot-grid" x="0" y="0" width="22" height="22" patternUnits="userSpaceOnUse">
              <circle cx="1.5" cy="1.5" r="0.9" fill="#94A3B8" opacity="0.32" />
            </pattern>
            <linearGradient id="grid-fade" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="white" stop-opacity="0" />
              <stop offset="0.07" stop-color="white" stop-opacity="1" />
              <stop offset="0.93" stop-color="white" stop-opacity="1" />
              <stop offset="1" stop-color="white" stop-opacity="0" />
            </linearGradient>
            <mask id="grid-mask"><rect width="1280" height="500" fill="url(#grid-fade)" /></mask>

            <!-- Card drop shadow -->
            <filter id="card-shadow" x="-10%" y="-10%" width="120%" height="120%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="4" />
              <feOffset dx="0" dy="3" />
              <feComponentTransfer><feFuncA type="linear" slope="0.07" /></feComponentTransfer>
              <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>

            <!-- Arrow markers -->
            <marker id="ar-or" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto" markerUnits="userSpaceOnUse">
              <path d="M0 0 L9 4.5 L0 9 L2.4 4.5 Z" fill="#FF5722" />
            </marker>
            <marker id="ar-te" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto" markerUnits="userSpaceOnUse">
              <path d="M0 0 L9 4.5 L0 9 L2.4 4.5 Z" fill="#009688" />
            </marker>
            <marker id="ar-bl" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto" markerUnits="userSpaceOnUse">
              <path d="M0 0 L9 4.5 L0 9 L2.4 4.5 Z" fill="#2563EB" />
            </marker>
          </defs>

          <!-- Background grid (fades at edges) -->
          <g mask="url(#grid-mask)" opacity="0.55">
            <rect width="1280" height="500" fill="url(#dot-grid)" />
          </g>

          <!-- Faint baseline rail beneath stations -->
          <line x1="100" y1="430" x2="1180" y2="430" stroke="#E2E8F0" stroke-width="1" stroke-dasharray="2 5" />
          <circle cx="100" cy="430" r="2.5" fill="#CBD5E1" />
          <circle cx="1180" cy="430" r="2.5" fill="#CBD5E1" />

          <!-- ============== EYEBROW LABELS ============== -->
          <g font-family="Roboto, Helvetica, Arial, sans-serif" font-size="10" font-weight="700" letter-spacing="0.22em">
            <text x="180" y="124" text-anchor="middle" fill="#E64A19">01 · SOURCE</text>
            <text x="490" y="124" text-anchor="middle" fill="#00796B">02 · BUILD</text>
            <text x="800" y="124" text-anchor="middle" fill="#004D40">03 · DISTRIBUTE</text>
            <text x="1100" y="124" text-anchor="middle" fill="#1D4ED8">04 · RUNTIME</text>
          </g>

          <!-- ============== STATION 1 — RECIPES ============== -->
          <g>
            <!-- Card -->
            <rect x="80" y="140" width="200" height="200" rx="20" fill="#FFFFFF" stroke="#FFAB91" stroke-width="1.4" filter="url(#card-shadow)" />
            <!-- Top accent strip -->
            <path d="M 80 140 H 280 V 156 H 80 Z" fill="#FF5722" opacity="0.08" />
            <rect x="80" y="140" width="200" height="3" fill="#FF5722" />

            <!-- Folded corner -->
            <path d="M 254 140 L 280 140 L 280 166 Z" fill="#FFCCBC" />
            <path d="M 254 140 L 280 166 L 254 166 Z" fill="#FFAB91" />
            <line x1="254" y1="166" x2="280" y2="166" stroke="#FF5722" stroke-width="0.6" opacity="0.4" />

            <!-- Filename -->
            <text x="100" y="184" font-family="JetBrains Mono, monospace" font-size="9" font-weight="500" fill="#94A3B8">biochef.yaml</text>

            <!-- YAML body -->
            <g font-family="JetBrains Mono, monospace" font-size="11">
              <text x="100" y="216"><tspan font-weight="700" fill="#FF5722">name</tspan><tspan fill="#525252">:</tspan><tspan dx="6" fill="#1A1A1A">aligner</tspan></text>
              <text x="100" y="236"><tspan font-weight="700" fill="#FF5722">version</tspan><tspan fill="#525252">:</tspan><tspan dx="6" fill="#1A1A1A">1.0.0</tspan></text>
              <text x="100" y="256"><tspan font-weight="700" fill="#FF5722">runtime</tspan><tspan fill="#525252">:</tspan><tspan dx="6" fill="#1A1A1A">wasm</tspan></text>
              <text x="100" y="276"><tspan font-weight="700" fill="#FF5722">inputs</tspan><tspan fill="#525252">:</tspan></text>
              <text x="100" y="294" fill="#525252"><tspan>  - </tspan><tspan fill="#1A1A1A">reads.fastq</tspan></text>
              <text x="100" y="312" fill="#525252"><tspan>  - </tspan><tspan fill="#1A1A1A">ref.fa</tspan></text>
            </g>

            <!-- Title -->
            <text x="180" y="370" text-anchor="middle" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="17" font-weight="700" fill="#1A1A1A">biochef-recipes</text>
            <text x="180" y="390" text-anchor="middle" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="11.5" font-weight="500" fill="#525252">YAML source of truth</text>
          </g>

          <!-- ============== EDGE A — Recipes → Hub ============== -->
          <g>
            <text x="330" y="222" text-anchor="middle" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="11" font-weight="600" fill="#E64A19" letter-spacing="0.06em">push</text>
            <circle cx="282" cy="240" r="3.5" fill="#FF5722" />
            <line x1="290" y1="240" x2="370" y2="240" stroke="#FF5722" stroke-width="2" stroke-linecap="round" marker-end="url(#ar-or)" />
            <text x="330" y="265" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9" fill="#94A3B8">workflow_call</text>
          </g>

          <!-- ============== STATION 2 — HUB ============== -->
          <g>
            <rect x="380" y="140" width="220" height="200" rx="20" fill="#FFFFFF" stroke="#80CBC4" stroke-width="1.4" filter="url(#card-shadow)" />
            <path d="M 380 140 H 600 V 156 H 380 Z" fill="#009688" opacity="0.06" />
            <rect x="380" y="140" width="220" height="3" fill="#009688" />

            <!-- Subheader -->
            <text x="400" y="184" font-family="JetBrains Mono, monospace" font-size="9" font-weight="500" fill="#94A3B8">.github/workflows/build.yml</text>

            <!-- Pipeline track -->
            <line x1="412" y1="210" x2="412" y2="318" stroke="#009688" stroke-width="1.6" stroke-linecap="round" opacity="0.45" />

            <!-- Step 1 -->
            <circle cx="412" cy="210" r="6.5" fill="#009688" />
            <path d="M 408.5 210.2 L 411 213 L 416 207.4" stroke="white" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <text x="430" y="214" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="12" font-weight="500" fill="#1A1A1A">validate</text>

            <!-- Step 2 -->
            <circle cx="412" cy="237" r="6.5" fill="#009688" />
            <path d="M 408.5 237.2 L 411 240 L 416 234.4" stroke="white" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <text x="430" y="241" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="12" font-weight="500" fill="#1A1A1A">build <tspan fill="#94A3B8" dx="2">→</tspan> <tspan font-family="JetBrains Mono, monospace" font-size="11" fill="#009688" dx="2">.wasm</tspan></text>

            <!-- Step 3 -->
            <circle cx="412" cy="264" r="6.5" fill="#009688" />
            <path d="M 408.5 264.2 L 411 267 L 416 261.4" stroke="white" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <text x="430" y="268" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="12" font-weight="500" fill="#1A1A1A">test <tspan fill="#94A3B8" dx="2">(golden)</tspan></text>

            <!-- Step 4 -->
            <circle cx="412" cy="291" r="6.5" fill="#009688" />
            <path d="M 408.5 291.2 L 411 294 L 416 288.4" stroke="white" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <text x="430" y="295" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="12" font-weight="500" fill="#1A1A1A">SBOM <tspan fill="#94A3B8" dx="1">·</tspan> SLSA</text>

            <!-- Step 5 -->
            <circle cx="412" cy="318" r="6.5" fill="#009688" />
            <path d="M 408.5 318.2 L 411 321 L 416 315.4" stroke="white" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <text x="430" y="322" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="12" font-weight="500" fill="#1A1A1A">cosign <tspan fill="#94A3B8" dx="1">·</tspan> publish</text>

            <!-- Title -->
            <text x="490" y="370" text-anchor="middle" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="17" font-weight="700" fill="#1A1A1A">biochef-hub</text>
            <text x="490" y="390" text-anchor="middle" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="11.5" font-weight="500" fill="#525252">CI on GitHub Actions</text>
          </g>

          <!-- ============== EDGE B — Hub → Registry ============== -->
          <g>
            <text x="650" y="222" text-anchor="middle" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="11" font-weight="600" fill="#00796B" letter-spacing="0.06em">publish</text>
            <circle cx="602" cy="240" r="3.5" fill="#009688" />
            <line x1="610" y1="240" x2="690" y2="240" stroke="#009688" stroke-width="2" stroke-linecap="round" marker-end="url(#ar-te)" />
            <text x="650" y="265" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9" fill="#94A3B8">ORAS · cosign</text>
          </g>

          <!-- ============== STATION 3 — REGISTRY ============== -->
          <g>
            <rect x="700" y="140" width="200" height="200" rx="20" fill="#FFFFFF" stroke="#80CBC4" stroke-width="1.4" filter="url(#card-shadow)" />
            <path d="M 700 140 H 900 V 156 H 700 Z" fill="#004D40" opacity="0.07" />
            <rect x="700" y="140" width="200" height="3" fill="#004D40" />

            <!-- Subheader -->
            <text x="720" y="184" font-family="JetBrains Mono, monospace" font-size="9" font-weight="500" fill="#94A3B8">index.json</text>

            <!-- Lock icon top-right -->
            <g transform="translate(866 174)">
              <path d="M 4 7 V 5 a 4 4 0 0 1 8 0 V 7" fill="none" stroke="#004D40" stroke-width="1.5" stroke-linecap="round" />
              <rect x="2" y="7" width="12" height="9" rx="1.6" fill="#004D40" />
              <circle cx="8" cy="11" r="1.2" fill="white" />
            </g>

            <!-- OCI layer pills -->
            <g>
              <!-- Layer 1 -->
              <rect x="718" y="208" width="164" height="34" rx="9" fill="#E0F2F1" stroke="#80CBC4" stroke-width="1" />
              <circle cx="734" cy="225" r="3" fill="#009688" />
              <text x="746" y="220" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="11" font-weight="600" fill="#1A1A1A">bundle.json</text>
              <text x="746" y="234" font-family="JetBrains Mono, monospace" font-size="8" fill="#94A3B8">application/vnd.biochef</text>

              <!-- Layer 2 -->
              <rect x="718" y="250" width="164" height="34" rx="9" fill="#E0F2F1" stroke="#80CBC4" stroke-width="1" />
              <circle cx="734" cy="267" r="3" fill="#009688" />
              <text x="746" y="262" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="11" font-weight="600" fill="#1A1A1A">aligner.wasm</text>
              <text x="746" y="276" font-family="JetBrains Mono, monospace" font-size="8" fill="#94A3B8">sha256:e3b0c44…</text>

              <!-- Layer 3 -->
              <rect x="718" y="292" width="164" height="34" rx="9" fill="#E0F2F1" stroke="#80CBC4" stroke-width="1" />
              <circle cx="734" cy="309" r="3" fill="#009688" />
              <text x="746" y="304" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="11" font-weight="600" fill="#1A1A1A">SBOM + sig</text>
              <text x="746" y="318" font-family="JetBrains Mono, monospace" font-size="8" fill="#94A3B8">cyclonedx · cosign</text>
            </g>

            <!-- Title -->
            <text x="800" y="370" text-anchor="middle" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="17" font-weight="700" fill="#1A1A1A">BioChef Registry</text>
            <text x="800" y="390" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="11" font-weight="500" fill="#004D40">registry.biochef.app</text>
          </g>

          <!-- ============== EDGE C — Registry → Browser (dashed = runtime) ============== -->
          <g>
            <text x="950" y="222" text-anchor="middle" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="11" font-weight="600" font-style="italic" fill="#1D4ED8" letter-spacing="0.06em">fetch</text>
            <circle cx="902" cy="240" r="3.5" fill="#2563EB" />
            <line x1="910" y1="240" x2="990" y2="240" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-dasharray="5 4" marker-end="url(#ar-bl)" />
            <text x="950" y="265" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9" fill="#94A3B8">by digest</text>
          </g>

          <!-- ============== STATION 4 — BROWSER ============== -->
          <g>
            <rect x="1000" y="140" width="200" height="200" rx="20" fill="#FFFFFF" stroke="#A6C8FB" stroke-width="1.4" filter="url(#card-shadow)" />
            <path d="M 1000 140 H 1200 V 156 H 1000 Z" fill="#2563EB" opacity="0.06" />
            <rect x="1000" y="140" width="200" height="3" fill="#2563EB" />

            <!-- Browser chrome -->
            <circle cx="1018" cy="178" r="3.6" fill="#FF6B6B" />
            <circle cx="1031" cy="178" r="3.6" fill="#FFD166" />
            <circle cx="1044" cy="178" r="3.6" fill="#06D6A0" />
            <rect x="1060" y="170" width="124" height="18" rx="9" fill="#F8FAFC" stroke="#DBEAFE" stroke-width="1" />
            <text x="1122" y="183" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9" fill="#525252">ieeta-pt.github.io</text>
            <line x1="1000" y1="200" x2="1200" y2="200" stroke="#DBEAFE" stroke-width="1" />

            <!-- Loaded WASM module pill -->
            <rect x="1022" y="218" width="156" height="32" rx="16" fill="#EFF6FF" stroke="#93C5FD" stroke-width="1" />
            <circle cx="1037" cy="234" r="3.2" fill="#2563EB">
              <animate attributeName="opacity" values="0.35;1;0.35" dur="2.2s" repeatCount="indefinite" />
            </circle>
            <text x="1100" y="238" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="11" font-weight="500" fill="#1D4ED8">aligner.wasm</text>

            <!-- Output bars (mimic alignment data) -->
            <g>
              <rect x="1022" y="266" width="156" height="3" rx="1.5" fill="#DBEAFE" />
              <rect x="1022" y="266" width="118" height="3" rx="1.5" fill="#60A5FA" />
              <rect x="1022" y="278" width="156" height="3" rx="1.5" fill="#DBEAFE" />
              <rect x="1022" y="278" width="92" height="3" rx="1.5" fill="#60A5FA" />
              <rect x="1022" y="290" width="156" height="3" rx="1.5" fill="#DBEAFE" />
              <rect x="1022" y="290" width="138" height="3" rx="1.5" fill="#60A5FA" />
              <rect x="1022" y="302" width="156" height="3" rx="1.5" fill="#DBEAFE" />
              <rect x="1022" y="302" width="74" height="3" rx="1.5" fill="#60A5FA" />
            </g>

            <!-- Status -->
            <text x="1100" y="324" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="9" fill="#16A34A">▸ executing in WebAssembly</text>

            <!-- Title -->
            <text x="1100" y="370" text-anchor="middle" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="17" font-weight="700" fill="#1A1A1A">BioChef web app</text>
            <text x="1100" y="390" text-anchor="middle" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="11.5" font-weight="500" fill="#525252">runs entirely in your tab</text>
          </g>

          <!-- ============== BOTTOM ANNOTATION ============== -->
          <text x="640" y="463" text-anchor="middle" font-family="Roboto, Helvetica, Arial, sans-serif" font-size="11" font-weight="500" fill="#94A3B8" letter-spacing="0.08em">Every artifact is content-addressable · every step is signed</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- Component Details -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="Deep dive"
        title="Component details"
        subtitle="Open each card to see what biochef-recipes, the Hub CI, the Registry, and the web app each do."
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 items-start">
