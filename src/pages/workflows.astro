---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import WorkflowDemo from '../components/WorkflowDemo.astro';
// fl-session.mdx is intentionally not imported: WES / TES / federated runtimes
// are roadmap items. The agent is shown as in development.

const scenarios = [
  {
    what: 'Map reads',
    how: 'Align reads with minimap2, then sort, index and summarise them with samtools. Test on a small sample here, then run the same workflow on the full dataset.',
    example: 'reads.fastq → minimap2 → samtools sort → samtools stats'
  },
  {
    what: 'QC and conversion',
    how: 'Trim and check reads with fastp, triage BAM files with samtools, and convert between formats such as GTF and GFF with gffread.',
    example: 'raw.fastq → fastp → clean.fastq'
  },
  {
    what: 'Viral consensus',
    how: 'Map reads to a reference and build a consensus genome with ivar or viralconsensus.',
    example: 'reads.fastq → minimap2 → samtools sort → viralconsensus'
  },
  {
    what: 'Teaching',
    how: 'Send a workflow file to a class. Everyone imports it in the browser and walks through the same steps.',
    example: 'workflow.json → Import workflow → Run'
  }
];
---

<BaseLayout title="Workflows · BioChef" description="Build a workflow in your browser, test it on small data, then run it where your data lives.">
  <PageHero
    kicker="Workflows"
    title="Build workflows"
    subtitle="Drag tools into a workflow and test it in your browser on small data. Export it as one file, ready to run where your data lives."
    crumbs={[{ label: 'Workflows' }]}
    meta={[
      { label: 'Editor', value: 'Drag-and-drop DAG with type filtering' },
      { label: 'Runtime', value: 'Browser today · agent in development' },
      { label: 'Formats', value: 'FASTA · FASTQ · BAM · CRAM · VCF · GFF · BED · JSON · …' },
      { label: 'Sharing', value: 'One workflow file (JSON)' }
    ]}
  />

  <!-- Demo video -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="See it in action"
        title="Watch a workflow run in the browser"
        subtitle="A short, silent preview of the BioChef app building and running a DAG. Press play for the full walkthrough with audio."
      />
      <WorkflowDemo />
    </div>
  </section>

  <!-- Example Scenarios -->
  <section class="section">
    <div class="container-main">
      <SectionHeader kicker="In practice" title="What people build" align="left" />
      <ul class="border-t border-border">
        {scenarios.map((x) => (
          <li class="grid gap-3 md:gap-10 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] py-7 md:py-8 border-b border-border">
            <h3 class="text-xl md:text-2xl font-medium text-text tracking-tight">{x.what}</h3>
            <div>
              <p class="text-base text-text-secondary leading-relaxed">{x.how}</p>
              <p class="mt-3 font-mono text-xs md:text-sm text-brand-dark break-words">{x.example}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tool catalogue snapshot -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="Catalogue"
        title="What you can chain together"
        subtitle="A snapshot of the 31 signed recipes in the public BioChef catalogue, grouped by what they do. Every tool runs as WebAssembly in the browser; 12 also have a native build for the agent."
      />

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        {[
          { name: 'GTO suite', items: 'sequence · format · genomic · amino acid · info · text', count: '57+ ops' },
          { name: 'Alignment & mapping', items: 'minimap2 · lastz · mummer4/nucmer · ssw · ksw2 · edlib', count: '6' },
          { name: 'Variants & consensus', items: 'bcftools · ivar · viralconsensus', count: '3' },
          { name: 'BAM/SAM & QC', items: 'samtools view/sort/stats · fastp · samblaster', count: '3' },
          { name: 'MSA & phylogenetics', items: 'muscle · kalign · abPOA · fasttree · ASTER · tn93', count: '6' },
          { name: 'Genome intervals', items: 'bedtools intersect · cgranges coverage', count: '2' },
          { name: 'Assembly, ORFs & methylation', items: 'fermi-lite assemble · prodigal · modbam2bed', count: '3' },
          { name: 'Sequence toolkits', items: 'seqtk · gffread — subseq · convert · filter', count: '2' },
          { name: 'Text, JSON & shell', items: 'gawk · grep · sed · jq · coreutils', count: '5' },
          { name: 'And growing', items: 'New recipes added by the community', count: '+' }
        ].map((cat) => (
          <article class="bg-surface rounded-xl border border-border p-5">
            <div class="flex items-baseline justify-between mb-2">
              <h3 class="text-sm font-medium text-text tracking-tight">{cat.name}</h3>
              <span class="font-mono text-xs font-semibold text-brand">{cat.count}</span>
            </div>
            <p class="font-mono text-[11px] text-text-tertiary leading-relaxed">{cat.items}</p>
          </article>
        ))}
      </div>

      <p class="text-center text-xs text-text-tertiary mt-8">
        Badges count recipes per family (GTO counts operations). Workflows can pipe FASTA, FASTQ, BAM, SAM, CRAM, VCF, BCF, BED, GFF, JSON, LIST and more between tools.
        <a class="text-brand hover:text-brand-dark ml-1" href="https://biochef.app/" target="_blank" rel="noreferrer">See the full catalogue in the app →</a>
      </p>
    </div>
  </section>

  <!-- Where workflows run -->
  <section class="section">
    <div class="container-main">
      <SectionHeader kicker="Runtime" title="Two places to run" align="left" />
      <div class="grid md:grid-cols-2 gap-px bg-border border border-border rounded-xl overflow-hidden">
        <article class="bg-surface p-7 md:p-9">
          <p class="text-[10px] font-semibold tracking-[0.12em] text-brand uppercase mb-3">Live</p>
          <h3 class="text-xl md:text-2xl font-medium text-text tracking-tight">In your browser</h3>
          <p class="mt-3 text-text-secondary leading-relaxed">For building and testing. Tools run client-side as WebAssembly on small data, with nothing to install and nothing uploaded.</p>
          <p class="mt-5 font-mono text-xs text-text-tertiary">Emscripten · biowasm · signed digest from the registry</p>
        </article>
        <article class="bg-surface p-7 md:p-9">
          <p class="text-[10px] font-semibold tracking-[0.12em] text-accent-dark uppercase mb-3">In development</p>
          <h3 class="text-xl md:text-2xl font-medium text-text tracking-tight">Next to your data</h3>
          <p class="mt-3 text-text-secondary leading-relaxed">For full runs. The BioChef agent runs the same signed tools on your workstation, a server or a secure environment, so large or sensitive data never has to move.</p>
          <p class="mt-5 font-mono text-xs text-text-tertiary">
            <a class="text-brand hover:text-brand-dark" href="https://github.com/ieeta-pt/biochef-agent" target="_blank" rel="noreferrer">ieeta-pt/biochef-agent</a>
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
