---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import WorkflowMock from '../components/WorkflowMock';
import WorkflowDemo from '../components/WorkflowDemo.astro';
import UseCaseCards from '../components/UseCaseCards';
import { LightningIcon } from '../components/Icons';
// fl-session.mdx and the MonitorIcon/CloudIcon are intentionally not imported in
// production: Agent / WES / TES / Federated runtimes are roadmap items, not shipped.
---

<BaseLayout title="Workflows · BioChef">
  <PageHero
    kicker="Workflows"
    title="Build workflows"
    subtitle="Drag bioinformatics tools into a DAG inside your browser tab. Outputs flow live, parameters re-execute on the fly, and the whole thing is just a static page that runs WebAssembly."
    crumbs={[{ label: 'Workflows' }]}
    meta={[
      { label: 'Editor', value: 'Drag-and-drop DAG with type filtering' },
      { label: 'Runtime', value: 'WebAssembly via biowasm' },
      { label: 'Formats', value: 'FASTA · FASTQ · BAM · CRAM · VCF · GFF · BED · JSON · …' },
      { label: 'Persistence', value: 'Recipes saved as JSON' }
    ]}
  />

  <!-- Demo video -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="See it in action"
        title="Watch a workflow run in the browser"
        subtitle="A short, silent preview of the BioChef app building and running a DAG. Press play for the full walkthrough with audio."
      />
      <WorkflowDemo />
    </div>
  </section>

  <!-- Workflow Mock -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="Editor preview"
        title="Drag, drop, and watch outputs flow"
        subtitle="A four-node sketch of what the Workflow page looks like in the BioChef app. Click a node to see what feeds it and what it produces."
      />
      <WorkflowMock client:load />
    </div>
  </section>

  <!-- Example Scenarios -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="In practice"
        title="Example scenarios"
        subtitle="Three things people actually do with the Workflow page today."
      />
      <UseCaseCards
        client:visible
        cases={[
          {
            title: 'Map reads & call variants',
            description: 'Align reads with minimap2, sort and index with samtools, then call variants with bcftools — or go viral: minimap2 → ivar / viralconsensus for a consensus genome. A full mapping-to-variants pipeline, no upload needed.',
            audience: 'Variant calling',
            tone: 'brand'
          },
          {
            title: 'QC, triage & conversion',
            description: 'Run fastp for QC and adapter trimming, chain samtools view/stats/flagstat or GTO statistics to triage FASTQ/BAM/CRAM, and convert between FASTA, FASTQ, SEQ, BAM ↔ SAM, GTF ↔ GFF (gffread). All in one signed recipe.',
            audience: 'Data prep',
            tone: 'accent'
          },
          {
            title: 'Teaching demo',
            description: 'Share a recipe link with a class. Anyone can open it in the browser and walk through the same DAG step by step.',
            audience: 'Education',
            tone: 'tertiary'
          }
        ]}
      />
    </div>
  </section>

  <!-- Tool catalogue snapshot -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="Catalogue"
        title="What you can chain together"
        subtitle="A snapshot of the 31 signed recipes currently in the public BioChef catalogue, grouped by what they do. Every tool runs as WebAssembly in your browser tab."
      />

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        {[
          { name: 'GTO suite', items: 'sequence · format · genomic · amino acid · info · text', count: '57+ ops' },
          { name: 'Alignment & mapping', items: 'minimap2 · lastz · mummer4/nucmer · ssw · ksw2 · edlib', count: '6' },
          { name: 'Variants & consensus', items: 'bcftools · ivar · viralconsensus', count: '3' },
          { name: 'BAM/SAM & QC', items: 'samtools view/sort/stats · fastp · samblaster', count: '3' },
          { name: 'MSA & phylogenetics', items: 'muscle · kalign · abPOA · fasttree · ASTER · tn93', count: '6' },
          { name: 'Genome intervals', items: 'bedtools intersect · cgranges coverage', count: '2' },
          { name: 'Assembly, ORFs & methylation', items: 'fermi-lite assemble · prodigal · modbam2bed', count: '3' },
          { name: 'Sequence toolkits', items: 'seqtk · gffread — subseq · convert · filter', count: '2' },
          { name: 'Text, JSON & shell', items: 'gawk · grep · sed · jq · coreutils', count: '5' },
          { name: 'And growing', items: 'New recipes added by the community', count: '+' }
        ].map((cat) => (
          <article class="bg-surface rounded-xl border border-border border-l-2 border-l-brand/40 p-5 hover:shadow-card-hover transition-shadow duration-200">
            <div class="flex items-baseline justify-between mb-2">
              <h3 class="text-sm font-medium text-text tracking-tight">{cat.name}</h3>
              <span class="font-mono text-xs font-semibold text-brand">{cat.count}</span>
            </div>
            <p class="font-mono text-[11px] text-text-tertiary leading-relaxed">{cat.items}</p>
          </article>
        ))}
      </div>

      <p class="text-center text-xs text-text-tertiary mt-8">
        Badges count recipes per family (GTO counts operations). Workflows can pipe FASTA, FASTQ, BAM, SAM, CRAM, VCF, BCF, BED, GFF, PAF, JSON, LIST and more between tools.
        <a class="text-brand hover:text-brand-dark ml-1" href="https://ieeta-pt.github.io/Biochef/" target="_blank" rel="noreferrer">See the full catalogue in the app →</a>
      </p>
    </div>
  </section>

  <!-- How execution works -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="Runtime"
        title="One runtime today"
        subtitle="Every step runs in the browser via WebAssembly. Server-side runtimes are on the roadmap."
      />

      <article class="bg-surface rounded-xl border border-border border-l-4 border-l-brand max-w-3xl mx-auto p-8 md:p-10 shadow-card">
        <div class="flex items-start gap-4 mb-6">
          <div class="flex-shrink-0 text-brand">
            <LightningIcon className="w-8 h-8" />
          </div>
          <div>
            <p class="text-[10px] font-semibold tracking-[0.12em] text-brand uppercase mb-2">Live runtime</p>
            <h3 class="text-xl font-medium text-text tracking-tight mb-2">Browser WebAssembly</h3>
            <p class="text-sm text-text-secondary leading-relaxed">
              Every shipped tool runs entirely in your browser tab. No upload, no install, no server.
            </p>
          </div>
        </div>

        <div class="grid sm:grid-cols-3 gap-5 pt-5 border-t border-border">
          <div>
            <p class="text-[10px] font-semibold tracking-[0.12em] text-text-tertiary uppercase mb-1">Where</p>
            <p class="text-sm text-text">Your browser tab</p>
          </div>
          <div>
            <p class="text-[10px] font-semibold tracking-[0.12em] text-text-tertiary uppercase mb-1">Compiled with</p>
            <p class="text-sm text-text">Emscripten · biowasm</p>
          </div>
          <div>
            <p class="text-[10px] font-semibold tracking-[0.12em] text-text-tertiary uppercase mb-1">Loaded by</p>
            <p class="text-sm text-text">Signed digest from registry</p>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
