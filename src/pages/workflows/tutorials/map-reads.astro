---
import Tutorial from '../../../components/Tutorial.astro';

// Hands-on tutorial. Every step, screenshot and expected result was checked in
// the live app (biochef.app) with the files in public/tutorials/map-reads.
const steps = [
  {
    title: 'Open the Workflow Builder',
    body: 'Go to <a href="https://biochef.app/" target="_blank" rel="noreferrer">biochef.app</a> and choose <strong>Workflow Builder</strong> in the top bar. If a short tour opens, close it. The canvas starts with one <strong>Input</strong> node.'
  },
  {
    title: 'Load the two files',
    body: 'In the right-hand panel, open <strong>File manager</strong> and upload <code>phix174.fasta</code> and <code>reads.fastq</code>. They are read by your browser; nothing is sent to a server.',
    image: { name: '01-upload', alt: 'The File manager panel listing reads.fastq and phix174.fasta after upload.' }
  },
  {
    title: 'Give the reads to the Input node',
    body: 'With the Input node selected, tick <code>reads.fastq</code>. The tool list on the left now shows only the tools that accept FASTQ.',
    image: { name: '02-filtered', alt: 'reads.fastq ticked; the tool list shows FASTQ tools such as fastp, seqtk and GTO.' }
  },
  {
    title: 'Add the aligner',
    body: 'Type <code>minimap</code> in <strong>Search Operations</strong> and click <strong>Align (minimap2)</strong>. A new node appears with two inputs, <em>ref</em> and <em>reads</em>. Drag from the dot under the Input node to the <em>reads</em> dot.',
    image: { name: '03-align-reads', alt: 'Input node connected to the reads input of the Align (minimap2) node by a line labelled FASTQ.' }
  },
  {
    title: 'Add the reference',
    body: 'Click <strong>Add input node</strong>, select the new node and tick <code>phix174.fasta</code>. Connect it to the <em>ref</em> dot. Each connection is labelled with the file type it carries: FASTA for the reference, FASTQ for the reads.',
    image: { name: '04-reference', alt: 'Two Input nodes connected to Align (minimap2): FASTA into ref and FASTQ into reads.' }
  },
  {
    title: 'Ask minimap2 for SAM output',
    body: 'Click the Align node and switch on <strong>sam_output</strong> (minimap2’s <code>-a</code> option). Without it, minimap2 writes PAF text, which samtools cannot read.',
    image: { name: '05-sam-output', alt: 'The Align (minimap2) settings with the sam_output switch turned on.' }
  },
  {
    title: 'Sort and summarise the alignments',
    body: 'With the Align node selected, search <code>sort</code> and add <strong>Sort (samtools)</strong>; connect Align to its <em>in</em> dot. Then add <strong>Flagstat (samtools)</strong> and connect Sort to it. Finally click <strong>Add output node</strong> and connect Flagstat to the Output.',
    image: { name: '06-workflow', alt: 'The finished workflow: two inputs, Align (minimap2), Sort (samtools), Flagstat (samtools) and Output, with connections labelled FASTA, FASTQ, SAM, BAM and TEXT.' }
  },
  {
    title: 'Run it and read the result',
    body: 'Click the green <strong>▶</strong> button at the top left of the workflow. It takes a few seconds. Click the <strong>Output</strong> node to see the flagstat report.',
    image: { name: '07-result', alt: 'The Output panel showing samtools flagstat: 400 reads in total, 380 mapped (95.00%).' }
  }
];
---

<Tutorial
  slug="map-reads"
  title="Map sequencing reads to a reference in your browser"
  heading="Map sequencing reads in your browser"
  subtitle="Build a workflow that aligns reads to a reference with minimap2, sorts them with samtools and reports how many mapped. Everything runs in your browser; nothing is installed or uploaded."
  description="A 20-minute hands-on tutorial: build a BioChef workflow that aligns reads with minimap2, sorts them with samtools and reports how many mapped, all in the browser with nothing to install."
  level="Beginner, no command line needed"
  time="About 20 minutes"
  minutes={20}
  keywords={['read mapping', 'minimap2', 'samtools', 'WebAssembly', 'workflow', 'genomics']}
  learn={[
    'Build a workflow by connecting tools in the BioChef editor',
    'Align reads to a reference with minimap2',
    'Sort the alignments and summarise them with samtools',
    'Save the workflow as a file and open it again'
  ]}
  data='The genome of bacteriophage PhiX174 (<a href="https://www.ncbi.nlm.nih.gov/nuccore/NC_001422.1" target="_blank" rel="noreferrer">NC_001422.1</a>, 5,386 bp) and 400 simulated 150 bp reads: 380 copied from the genome with about 0.5% errors, and 20 random reads that should not map.'
  downloads={[
    { label: 'Download phix174.fasta (5 KB)', file: 'phix174.fasta', primary: true },
    { label: 'Download reads.fastq (126 KB)', file: 'reads.fastq' }
  ]}
  steps={steps}
  expected={{
    code: '400 + 0 in total (QC-passed reads + QC-failed reads)\n...\n380 + 0 mapped (95.00% : N/A)',
    body: '380 of the 400 reads map: the 380 that came from PhiX174. The 20 random reads do not. If your numbers differ, check that <strong>sam_output</strong> is on and that the reference goes into <em>ref</em> and the reads into <em>reads</em>.'
  }}
  extras={[
    {
      title: 'Look under the hood',
      body: 'The small <strong>ⓘ</strong> on a node opens the tool’s own log. For minimap2 it shows the version (2.22-r1101), how many reads were mapped and the exact command that ran: the same tool you would run on a server, compiled to WebAssembly.',
      image: { name: '08-log', alt: 'The log of Align (minimap2): index statistics, 400 sequences mapped, version 2.22-r1101 and the command line.' }
    },
    {
      title: 'Save and share the workflow',
      body: 'Click <strong>Export workflow</strong> to download it as one JSON file, and <strong>Import workflow</strong> to open it again, on any computer. The file also contains the data loaded in its Input nodes, so do not share it as it is if those files are sensitive. Short on time? Import the finished workflow, data included, and press ▶.',
      downloads: [{ label: 'Download the finished workflow (JSON)', file: 'map-reads-workflow.json' }]
    }
  ]}
  exercise={{
    title: 'Exercise: how much of the genome is covered?',
    body: 'Select the Sort node and add <strong>Coverage (samtools)</strong>. Connect Sort to it, add a second Output node and run again. You should get one line for NC_001422.1 with <strong>380</strong> reads, <strong>99.16%</strong> of the genome covered and a mean depth of about <strong>10.6</strong>.',
    image: { name: '09-exercise', alt: 'The workflow with a second branch: Sort feeds both Flagstat and Coverage (samtools); the coverage output shows 380 reads and 99.1645% coverage.' },
    solution: { label: 'Download the solution workflow (JSON)', file: 'map-reads-solution.json' }
  }}
/>
