---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import WorkflowDemo from '../../components/WorkflowDemo.astro';
import { getCatalogStats } from '../../utils/catalog';
// fl-session.mdx is intentionally not imported: WES / TES / federated runtimes
// are roadmap items. The agent is shown as in development.
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const catalog = await getCatalogStats();

// Recipe ids per family; counts come from the registry at build time.
const families = [
  { name: 'GTO suite', items: 'sequence · format · genomic · amino acid · info · text', recipes: ['gto'], countOps: true },
  { name: 'Alignment & mapping', items: 'minimap2 · lastz · mummer4/nucmer · ssw · ksw2 · edlib', recipes: ['minimap2', 'lastz', 'mummer4', 'ssw', 'ksw2', 'edlib'] },
  { name: 'Variants & consensus', items: 'bcftools · ivar · viralconsensus', recipes: ['bcftools', 'ivar', 'viralconsensus'] },
  { name: 'BAM/SAM & QC', items: 'samtools view/sort/stats · fastp · samblaster', recipes: ['samtools', 'fastp', 'samblaster'] },
  { name: 'MSA & phylogenetics', items: 'muscle · kalign · abPOA · fasttree · ASTER · tn93', recipes: ['muscle', 'kalign', 'abpoa', 'fasttree', 'aster', 'tn93'] },
  { name: 'Genome intervals', items: 'bedtools intersect · cgranges coverage', recipes: ['bedtools', 'cgranges'] },
  { name: 'Assembly, ORFs & methylation', items: 'fermi-lite assemble · prodigal · modbam2bed', recipes: ['fermilite', 'prodigal', 'modbam2bed'] },
  { name: 'Sequence toolkits', items: 'seqtk · gffread — subseq · convert · filter', recipes: ['seqtk', 'gffread'] },
  { name: 'Text, JSON & shell', items: 'gawk · grep · sed · jq · coreutils', recipes: ['gawk', 'grep', 'sed', 'jq', 'coreutils'] }
];
const published = catalog.operationsByRecipe;
const known = new Set(families.flatMap((f) => f.recipes));
const newRecipes = catalog.source === 'registry' ? Object.keys(published).filter((r) => !known.has(r)).sort() : [];
const familyCards = [
  ...families.map((f) => ({
    name: f.name,
    items: f.items,
    count: f.countOps
      ? `${published.gto ?? 57} ops`
      : String(catalog.source === 'registry' ? f.recipes.filter((r) => r in published).length : f.recipes.length)
  })),
  ...(newRecipes.length ? [{ name: 'Recently added', items: newRecipes.join(' · '), count: String(newRecipes.length) }] : [])
];

const steps = [
  {
    title: 'Build',
    body: 'Drag tools onto the canvas and connect them. Each connection shows the file type it carries.'
  },
  {
    title: 'Test',
    body: 'Run it in your browser on a small sample. Results open next to the graph, and nothing is uploaded.'
  },
  {
    title: 'Run on the full data',
    body: 'Export the workflow as one JSON file, then share it or run it where the data is.',
    link: { label: 'Where it can run', href: '#runtime' }
  }
];

import { TUTORIALS, GROUPINGS } from '../../data/tutorials';
const groupedBy = (key) => {
  const g = GROUPINGS.find((x) => x.key === key);
  return Object.entries(g.groups).map(([id, meta]) => ({ id, ...meta, items: TUTORIALS.filter((t) => t[key] === id) })).filter((x) => x.items.length);
};
---

<BaseLayout title="Workflows · BioChef" description="Build a workflow in your browser, test it on small data, then run it where your data lives.">
  <PageHero
    kicker="Workflows"
    title="Build workflows"
    subtitle="Drag tools into a workflow and test it in your browser on small data. Export it as one file, ready to run where your data lives."
    crumbs={[{ label: 'Workflows' }]}
    meta={[
      { label: 'Editor', value: 'Drag-and-drop DAG with type filtering' },
      { label: 'Runtime', value: 'Browser today · agent in development' },
      { label: 'Formats', value: 'FASTA · FASTQ · BAM · CRAM · VCF · GFF · BED · JSON · …' },
      { label: 'Sharing', value: 'One workflow file (JSON)' }
    ]}
  />

  <!-- From test to full run -->
  <section class="section">
    <div class="container-main">
      <div class="grid gap-10 lg:gap-14 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] items-center">
        <div>
          <p class="text-xs font-semibold tracking-[0.12em] uppercase text-brand-dark mb-3">How it works</p>
          <h2 class="text-3xl md:text-4xl font-medium text-text tracking-tight">From a quick test to a full run</h2>
          <ol class="mt-8 space-y-7">
            {steps.map((step, i) => (
              <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-4">
                <span class="font-mono text-sm text-brand-dark pt-0.5">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="text-lg font-medium text-text tracking-tight">{step.title}</h3>
                  <p class="mt-1.5 text-text-secondary leading-relaxed">{step.body}</p>
                  {step.link && (
                    <a class="mt-2 inline-block text-sm font-medium text-brand-dark underline underline-offset-2 hover:text-brand-800" href={step.link.href}>{step.link.label} ↓</a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>

        <figure>
          <div class="rounded-xl overflow-hidden border border-border bg-surface shadow-lg">
            <img
              src={withBase('/img/workflows/editor-dag.webp')}
              width="848"
              height="705"
              loading="lazy"
              decoding="async"
              class="block w-full h-auto"
              alt="The BioChef workflow editor with a GFF file and a genome feeding gffread, GTO and seqtk tools into five outputs."
            />
          </div>
          <figcaption class="mt-3 text-xs text-text-tertiary leading-relaxed">
            A workflow in the BioChef editor: a GFF file and a genome go through gffread (CDS, proteins, exons), then GTO and seqtk summarise each result.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Demo video -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="See it in action"
        title="Watch a workflow run in the browser"
      />
      <WorkflowDemo />
    </div>
  </section>

  <!-- Tutorials -->
  <section class="section scroll-mt-24" id="tutorials">
    <div class="container-main">
      <SectionHeader
        kicker="Tutorials"
        title="Learn by doing"
        subtitle={`${TUTORIALS.length} hands-on tutorials with small example data and the result you should get. Each one runs in your browser and ends with an exercise. New here? Start with “Map reads to a reference”.`}
        align="left"
      />

      <div class="flex flex-wrap items-center gap-3 mb-8" role="group" aria-label="Group tutorials by">
        <span class="text-sm text-text-secondary">Group by</span>
        {GROUPINGS.map((g, i) => (
          <button type="button" data-group-by={g.key} aria-pressed={i === 0 ? 'true' : 'false'}
            class="tutorial-tab rounded-full border px-4 py-1.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
            {g.label}
          </button>
        ))}
      </div>

      {GROUPINGS.map((g, gi) => (
        <div data-grouping={g.key} hidden={gi !== 0} class="space-y-12">
          {groupedBy(g.key).map((group) => (
            <div>
              <h3 class="text-xl font-medium text-text tracking-tight">{group.label}</h3>
              <p class="mt-1 text-sm text-text-secondary">{group.note}</p>
              <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {group.items.map((t) => (
                  <li>
                    <a href={withBase(`/workflows/tutorials/${t.slug}`)} class="group flex flex-col h-full bg-surface border border-border rounded-xl shadow-card p-5 md:p-6 transition-shadow hover:shadow-card-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">
                      <span class="font-mono text-xs text-brand-dark">{t.time}</span>
                      <h4 class="mt-1.5 text-lg font-medium text-text tracking-tight group-hover:text-brand-dark">{t.title}</h4>
                      <p class="mt-2 text-sm text-text-secondary leading-relaxed">{t.summary}</p>
                      <p class="mt-auto pt-4 font-mono text-xs text-text-tertiary">{t.tools}</p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ))}

      <p class="mt-10 text-text-secondary">
        Teaching a class? Each tutorial includes its data and a finished workflow file, so students can import it and catch up at any step.
      </p>
    </div>
  </section>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-group-by]');
    const views = document.querySelectorAll<HTMLElement>('[data-grouping]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const key = tab.dataset.groupBy;
        tabs.forEach((t) => t.setAttribute('aria-pressed', String(t === tab)));
        views.forEach((v) => { v.hidden = v.dataset.grouping !== key; });
      });
    });
  </script>

  <!-- Tool catalogue snapshot -->
  <section class="section">
    <div class="container-main">
      <SectionHeader
        kicker="Catalogue"
        title="What you can chain together"
        subtitle={`The ${catalog.recipes} signed recipes in the public BioChef catalogue, grouped by what they do. Every tool runs as WebAssembly in the browser; ${catalog.native} also have a native build for the agent.`}
      />

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">
        {familyCards.map((cat) => (
          <article class="bg-surface rounded-xl border border-border shadow-xs p-5">
            <div class="flex items-baseline justify-between mb-2">
              <h3 class="text-sm font-medium text-text tracking-tight">{cat.name}</h3>
              <span class="font-mono text-xs font-semibold text-brand-dark">{cat.count}</span>
            </div>
            <p class="font-mono text-[11px] text-text-tertiary leading-relaxed">{cat.items}</p>
          </article>
        ))}
      </div>

      <p class="text-center text-xs text-text-tertiary mt-8">
        Badges count recipes per family (GTO counts operations); {catalog.operations} operations in all. New recipes are added by the community. Workflows can pipe FASTA, FASTQ, BAM, SAM, CRAM, VCF, BCF, BED, GFF, JSON, LIST and more between tools.
        <a class="text-brand-dark underline underline-offset-2 hover:text-brand-800 ml-1" href="https://biochef.app/" target="_blank" rel="noreferrer">See the full catalogue in the app →</a>
      </p>
    </div>
  </section>

  <!-- Where workflows run -->
  <section class="section scroll-mt-24" id="runtime">
    <div class="container-main">
      <SectionHeader kicker="Runtime" title="Two places to run" align="left" />
      <div class="grid md:grid-cols-2 gap-px bg-border border border-border rounded-xl overflow-hidden">
        <article class="bg-surface p-7 md:p-9">
          <p class="text-[10px] font-semibold tracking-[0.12em] text-brand-dark uppercase mb-3">Live</p>
          <h3 class="text-xl md:text-2xl font-medium text-text tracking-tight">In your browser</h3>
          <p class="mt-3 text-text-secondary leading-relaxed">For building and testing. Tools run client-side as WebAssembly on small data, with nothing to install and nothing uploaded.</p>
          <p class="mt-5 font-mono text-xs text-text-tertiary">Emscripten · biowasm · signed digest from the registry</p>
        </article>
        <article class="bg-surface p-7 md:p-9">
          <p class="text-[10px] font-semibold tracking-[0.12em] text-accent-800 uppercase mb-3">In development</p>
          <h3 class="text-xl md:text-2xl font-medium text-text tracking-tight">Next to your data</h3>
          <p class="mt-3 text-text-secondary leading-relaxed">For full runs. The BioChef agent runs the same signed tools on your workstation, a server or a secure environment, so large or sensitive data never has to move.</p>
          <p class="mt-5 font-mono text-xs text-text-tertiary">
            <a class="text-brand-dark underline underline-offset-2 hover:text-brand-800" href="https://github.com/ieeta-pt/biochef-agent" target="_blank" rel="noreferrer">ieeta-pt/biochef-agent</a>
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
