---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero';
import ArchitecturePreview from '../components/ArchitecturePreview';
import PillarCards from '../components/PillarCards';
import SectionHeader from '../components/SectionHeader.astro';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const withBase = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const audiences = [
  {
    who: 'Clinicians and clinical geneticists',
    job: 'Check a patient sample without sending it anywhere.',
    what: 'Quick checks run in your browser. No install, no upload, no account.',
    input: 'patient.fasta',
    steps: ['Fasta Extract'],
    output: 'result',
    agent: true
  },
  {
    who: 'Researchers',
    job: 'Test a workflow on a sample, then run it on the full dataset.',
    what: 'Export it as one file so a colleague can repeat exactly the same steps.',
    input: 'reads.fastq',
    steps: ['minimap2', 'samtools sort', 'samtools stats'],
    agent: true
  },
  {
    who: 'Teachers and students',
    job: 'Give a whole class the same tools in minutes.',
    what: 'Every student runs them in the browser on their own laptop. No accounts, no cluster, no setup.',
    input: 'workflow.json',
    steps: ['Import workflow', 'Run'],
    agent: false
  }
];
---

<BaseLayout
  title="BioChef · Easy genomics, private by design"
  description="Test genomic workflows in your browser, then run them where your data lives. Open, signed bioinformatics tools."
>
  <Hero
    client:load
    title="Easy genomics"
    titleHighlight="Private by design"
    subtitle="Test in your browser. Run where your data lives. Open, signed bioinformatics tools, from a quick check on your laptop to a full run next to the data."
    ctaPrimary={{ label: 'Open the app', href: 'https://biochef.app/' }}
    ctaSecondary={{ label: 'GitHub', href: 'https://github.com/ieeta-pt/Biochef' }}
    demo={{ src: withBase('/video/promo.mp4'), poster: withBase('/video/promo-poster.jpg'), href: withBase('/workflows#workflow-demo') }}
  />

  <!-- Who it's for -->
  <section class="section relative">
    <div class="container-main relative z-10">
      <SectionHeader
        kicker="Who it's for"
        title="Made for the people who handle the data"
        align="left"
      />
      <ul class="grid gap-5 md:grid-cols-3 md:grid-rows-[auto_1fr_auto] md:gap-y-0">
        {audiences.map((a) => (
          <li class="flex flex-col md:grid md:grid-rows-subgrid md:row-span-3 bg-surface border border-border rounded-xl shadow-card">
            <div class="p-6 md:p-7">
              <h3 class="text-[11px] font-semibold tracking-[0.12em] uppercase text-brand-dark">{a.who}</h3>
              <p class="mt-3 text-xl md:text-[1.375rem] leading-snug font-medium text-text tracking-tight">{a.job}</p>
              <p class="mt-3 text-[15px] text-text-secondary leading-relaxed">{a.what}</p>
            </div>

            <ol class="who-flow mx-6 md:mx-7 mb-6 md:mb-7" aria-label={`Example workflow: ${[a.input, ...a.steps, a.output].filter(Boolean).join(', ')}`}>
              <li class="who-node"><span class="who-chip who-chip--file">{a.input}</span></li>
              {a.steps.map((step) => (
                <li class="who-node"><span class="who-chip who-chip--tool">{step}</span></li>
              ))}
              {a.output && <li class="who-node"><span class="who-chip who-chip--out">{a.output}</span></li>}
            </ol>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 px-6 md:px-7 py-4 border-t border-border text-xs">
              <span class="font-mono uppercase tracking-[0.1em] text-text-tertiary">Runs</span>
              <span class="inline-flex items-center gap-1.5 text-text"><span class="w-1.5 h-1.5 rounded-full bg-brand"></span>In the browser</span>
              {a.agent && (
                <span class="inline-flex items-center gap-1.5 text-text-secondary"><span class="w-1.5 h-1.5 rounded-full border border-accent-dark"></span>Next to your data <span class="text-[#bf360c]">· in development</span></span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Pillars Section -->
  <section class="section relative">
    <div class="container-main relative z-10">
      <SectionHeader
        kicker="Platform pillars"
        title="What you get"
        subtitle="A signed publishing pipeline, a hybrid runtime, and a workflow editor. All open source."
      />
      <PillarCards
        client:visible
        pillars={[
          {
            kicker: '01 · Publish',
            title: 'Recipes → Hub → Registry',
            description: 'Tools are declared as YAML recipes, validated and built by biochef-hub (SBOM, SLSA, cosign), then published as signed bundles to the BioChef Registry.',
            icon: 'compass',
            tone: 'accent'
          },
          {
            kicker: '02 · Run',
            title: 'Browser and agent',
            description: 'Every tool runs in the browser as WebAssembly, for quick tests on small data. The BioChef agent, in development, runs the same signed tools next to your data.',
            icon: 'rocket',
            tone: 'brand'
          },
          {
            kicker: '03 · Compose',
            title: 'Drag-and-drop DAGs',
            description: 'A DAG editor chains tools end-to-end. Tools are filtered by data type, parameters re-execute live, and workflows can be exported and shared as JSON.',
            icon: 'workflow',
            tone: 'tertiary'
          }
        ]}
      />
    </div>
  </section>

  <!-- Architecture Preview -->
  <section class="section relative">
    <!-- Gradient background -->
    <div class="absolute inset-0 bg-linear-to-b from-background via-background to-brand-light/20"></div>

    <div class="container-main relative z-10">
      <SectionHeader
        kicker="System design"
        title="Architecture at a glance"
        subtitle="A YAML recipe in Git, signed by the Hub CI, served from the BioChef Registry, and run as WebAssembly in your browser."
      />
      <ArchitecturePreview client:visible />
    </div>
  </section>

  <!-- Ecosystem Section -->
  <section class="section relative">
    <div class="container-main relative z-10">
      <SectionHeader
        kicker="Standards"
        title="Ecosystem fit"
        subtitle="Built on open standards and designed to integrate with existing infrastructure."
      />
      <div class="card grid md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-border">
        <article class="p-6 md:p-8">
          <div class="inline-flex items-center justify-center w-10 h-10 mb-4 text-brand">
            <svg viewBox="0 0 32 24" class="w-9 h-7" role="img" aria-label="WebAssembly binary glyph">
              <g font-family="JetBrains Mono, monospace" font-size="6" font-weight="700" fill="currentColor" letter-spacing="0.4">
                <text x="2" y="8">10110</text>
                <text x="2" y="16">01001</text>
                <text x="2" y="23">11010</text>
              </g>
              <rect x="22" y="4" width="8" height="16" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.4" />
              <line x1="24" y1="9" x2="28" y2="9" stroke="currentColor" stroke-width="1" />
              <line x1="24" y1="13" x2="28" y2="13" stroke="currentColor" stroke-width="1" />
              <line x1="24" y1="17" x2="26.5" y2="17" stroke="currentColor" stroke-width="1" />
            </svg>
          </div>
          <p class="text-[10px] font-semibold tracking-[0.12em] text-brand uppercase mb-2">Runtime</p>
          <h3 class="text-lg font-medium text-text mb-2 tracking-tight">WebAssembly</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Bioinformatics tools compiled with Emscripten and biowasm, so tests run right in the browser.</p>
        </article>

        <article class="p-6 md:p-8">
          <div class="inline-flex items-center justify-center w-10 h-10 mb-4 text-accent">
            <svg viewBox="0 0 32 24" class="w-9 h-7" role="img" aria-label="OCI registry stacked layers glyph">
              <rect x="6" y="4" width="22" height="4" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.2" />
              <rect x="6" y="10" width="22" height="4" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.2" />
              <rect x="6" y="16" width="22" height="4" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.2" />
              <circle cx="9.6" cy="6" r="0.9" fill="currentColor" />
              <circle cx="9.6" cy="12" r="0.9" fill="currentColor" />
              <circle cx="9.6" cy="18" r="0.9" fill="currentColor" />
              <g transform="translate(0 2)">
                <path d="M 1.4 4 V 2.5 a 1.6 1.6 0 0 1 3.2 0 V 4" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
                <rect x="0.5" y="4" width="5" height="3.6" rx="0.7" fill="currentColor" />
              </g>
            </svg>
          </div>
          <p class="text-[10px] font-semibold tracking-[0.12em] text-accent uppercase mb-2">Distribution</p>
          <h3 class="text-lg font-medium text-text mb-2 tracking-tight">OCI Registry</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Signed bundles published to <code>registry.biochef.app</code> with SBOM and SLSA provenance.</p>
        </article>

        <article class="p-6 md:p-8">
          <div class="inline-flex items-center justify-center w-10 h-10 mb-4 text-tertiary">
            <svg viewBox="0 0 32 24" class="w-9 h-7" role="img" aria-label="cosign signature glyph">
              <path d="M 2 16 C 5 10, 8 8, 11 14 C 13 18, 16 6, 19 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              <line x1="2" y1="20" x2="20" y2="20" stroke="currentColor" stroke-width="0.8" stroke-dasharray="1.5 1.2" opacity="0.55" />
              <circle cx="25" cy="12" r="5.5" fill="none" stroke="currentColor" stroke-width="1.3" />
              <path d="M 22.6 12 L 24.4 13.8 L 27.4 10.4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <p class="text-[10px] font-semibold tracking-[0.12em] text-tertiary uppercase mb-2">Provenance</p>
          <h3 class="text-lg font-medium text-text mb-2 tracking-tight">Sigstore cosign</h3>
          <p class="text-sm text-text-secondary leading-relaxed">Every recipe is built, tested, signed, and an immutable digest is recorded in the signed <code>index.json</code>.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Single try-it CTA after pillars (replaces the redundant Choose-your-path section) -->
  <section class="section">
    <div class="container-main">
      <div class="bg-surface rounded-xl border border-border p-8 md:p-10 shadow-card text-center">
        <p class="text-[10px] font-semibold tracking-[0.12em] text-brand uppercase mb-3">Try it now</p>
        <h2 class="text-2xl md:text-3xl font-medium text-text mb-3 tracking-tight">Try BioChef in your browser</h2>
        <p class="text-base text-text-secondary max-w-xl mx-auto mb-6 leading-relaxed">
          Pick a tool, paste a sequence, run it. The whole catalogue is one click away.
        </p>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3">
          <a
            class="inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-brand text-white text-sm font-medium uppercase tracking-[0.06em] rounded-md transition-all hover:bg-brand-dark hover:shadow-button focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
            href="https://biochef.app/"
            target="_blank"
            rel="noreferrer"
          >
            Open the app
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
          <a
            class="inline-flex items-center justify-center gap-2 px-6 py-2.5 text-brand text-sm font-medium uppercase tracking-[0.06em] rounded-md border border-brand/40 hover:border-brand hover:bg-brand/4 transition-all focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
            href={withBase('/architecture')}
          >
            See how it works
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
